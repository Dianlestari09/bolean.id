---
const currentPath = Astro.url.pathname;
---

<nav class="navbar">
  <div class="container navbar-container">
    <a href="/" class="navbar-logo">
      <img src="/logo.png" alt="Bolean Logo" width="140" height="35" style="object-fit: contain;" />
    </a>
    
    <button class="mobile-toggle" aria-label="Toggle Menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
    </button>
    
    <ul class="navbar-nav">
      <li><a href="/" class={`nav-link ${currentPath === '/' ? 'active' : ''}`}>Beranda</a></li>
      <li><a href="/about" class={`nav-link ${currentPath.startsWith('/about') ? 'active' : ''}`}>Tentang Kami</a></li>
      <li><a href="/team" class={`nav-link ${currentPath.startsWith('/team') ? 'active' : ''}`}>Tim</a></li>
      <li class="nav-item-dropdown">
        <a href="/services" class={`nav-link ${currentPath.startsWith('/services') ? 'active' : ''}`}>
          <span>Layanan</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-left: 4px; display: inline-block; vertical-align: middle;"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </a>
        <ul class="dropdown-menu">
          <li><a href="/services/software" class="dropdown-link">Pembuatan Custom Software</a></li>
          <li><a href="/services/hardware" class="dropdown-link">Pembuatan Hardware</a></li>
          <li><a href="/services/iot" class="dropdown-link">Pembuatan IoT</a></li>
          <li><a href="/services/website" class="dropdown-link">Pembuatan Website</a></li>
          <li><a href="/services/pengelolaan-website" class="dropdown-link">Pengelolaan Website</a></li>
          <li><a href="/services/otomasi-ai" class="dropdown-link">Otomasi & AI Bisnis</a></li>
        </ul>
      </li>
      <li><a href="/portofolio" class={`nav-link ${currentPath.startsWith('/portofolio') || currentPath.startsWith('/projects') ? 'active' : ''}`}>Portofolio</a></li>
      <li><a href="/blog" class={`nav-link ${currentPath.startsWith('/blog') ? 'active' : ''}`}>Blog</a></li>
      <li><a href="/contact" class={`nav-link ${currentPath.startsWith('/contact') ? 'active' : ''}`}>Kontak</a></li>
      <li class="nav-cta-mobile">
        <a href="https://wa.me/6281259145879?text=Halo%20Bolean,%20saya%20ingin%20konsultasi%20gratis%20mengenai%20layanan%20IT%20dan%20teknologi" target="_blank" class="nav-cta-btn">
          <span>Konsultasi Gratis</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </li>
    </ul>

    <!-- CTA Button on Far Right of Desktop Navbar -->
    <div class="navbar-actions">
      <a href="https://wa.me/6281259145879?text=Halo%20Bolean,%20saya%20ingin%20konsultasi%20gratis%20mengenai%20layanan%20IT%20dan%20teknologi" target="_blank" class="nav-cta-btn">
        <span>Konsultasi Gratis</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </a>
    </div>
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileToggle = document.querySelector('.mobile-toggle');
    const navbarNav = document.querySelector('.navbar-nav');
    const dropdownItem = document.querySelector('.nav-item-dropdown');
    
    if(mobileToggle && navbarNav) {
      mobileToggle.addEventListener('click', () => {
        navbarNav.classList.toggle('active');
      });
    }
    
    if(dropdownItem) {
      dropdownItem.addEventListener('click', (e) => {
        if(window.innerWidth <= 992) {
          const target = e.target as HTMLElement | null;
          if (target && target.classList.contains('nav-link')) {
            e.preventDefault();
            dropdownItem.classList.toggle('open');
          }
        }
      });
    }
  });
</script>

<style>
  .navbar-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 80px;
    gap: 1.5rem;
  }

  .navbar-actions {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .nav-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-primary);
    color: white;
    font-weight: 700;
    font-size: 0.92rem;
    padding: 0.65rem 1.35rem;
    border-radius: 50px;
    box-shadow: 0 4px 14px rgba(13, 168, 158, 0.3);
    transition: all var(--transition-fast);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-cta-btn:hover {
    background: var(--color-secondary);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(8, 39, 82, 0.25);
  }

  .nav-cta-btn svg {
    transition: transform var(--transition-fast);
  }

  .nav-cta-btn:hover svg {
    transform: translateX(3px);
  }

  .nav-cta-mobile {
    display: none;
    width: 100%;
    margin-top: 0.5rem;
  }

  .mobile-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--color-secondary);
    cursor: pointer;
    padding: 0.5rem;
    align-items: center;
    justify-content: center;
    transition: color var(--transition-fast);
  }
  
  .mobile-toggle:hover {
    color: var(--color-primary);
  }
  
  @media (max-width: 992px) {
    .navbar-actions {
      display: none;
    }

    .nav-cta-mobile {
      display: block;
    }

    .nav-cta-mobile .nav-cta-btn {
      width: 100%;
      justify-content: center;
      padding: 0.85rem 1.5rem;
    }

    .mobile-toggle {
      display: flex;
    }
    
    .navbar-nav {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background: white;
      flex-direction: column;
      gap: 1.25rem;
      padding: 2rem;
      box-shadow: 0 10px 20px rgba(0,0,0,0.05);
      border-top: 1px solid var(--color-surface);
      
      /* Hidden by default on mobile */
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition: all 0.3s ease;
      align-items: flex-start;
      box-sizing: border-box;
    }
    
    .navbar-nav.active {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    
    .nav-item-dropdown {
      width: 100%;
    }
    
    .nav-item-dropdown .dropdown-menu {
      position: static;
      box-shadow: none;
      opacity: 0;
      visibility: hidden;
      transform: none;
      padding: 0 0 0 1.5rem;
      border-left: 2px solid var(--color-surface);
      margin-top: 0;
      display: none;
      min-width: 100%;
      background: transparent;
    }
    
    .nav-item-dropdown.open .dropdown-menu {
      display: block;
      opacity: 1;
      visibility: visible;
      margin-top: 0.5rem;
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
    }
    
    .dropdown-link {
      padding: 0.5rem 0;
    }
    
    .nav-link {
      font-size: 1.1rem;
    }
  }
</style>
