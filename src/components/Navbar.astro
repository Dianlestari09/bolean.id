---
const currentPath = Astro.url.pathname;
---

<nav class="navbar">
  <div class="container">
    <a href="/" class="navbar-logo">
      <img src="/logo.png" alt="Bolean Logo" width="140" height="35" style="object-fit: contain;" />
    </a>
    <ul class="navbar-nav">
      <li><a href="/" class={`nav-link ${currentPath === "/" ? "active" : ""}`}>Home</a></li>
      <li><a href="/about" class={`nav-link ${currentPath.startsWith("/about") ? "active" : ""}`}>About</a></li>
      <li><a href="/team" class={`nav-link ${currentPath.startsWith("/team") ? "active" : ""}`}>Team</a></li>
      <li class="nav-item-dropdown">
        <a href="/services" class={`nav-link ${currentPath.startsWith("/services") ? "active" : ""}`}>Services ▾</a>
        <ul class="dropdown-menu">
          <li><a href="/services/software" class="dropdown-link">Software</a></li>
          <li><a href="/services/hardware" class="dropdown-link">Hardware</a></li>
          <li><a href="/services/iot" class="dropdown-link">IoT</a></li>
        </ul>
      </li>
      <li><a href="/blog" class={`nav-link ${currentPath.startsWith("/blog") ? "active" : ""}`}>Blog</a></li>
      <li><a href="/contact" class={`nav-link ${currentPath.startsWith("/contact") ? "active" : ""}`}>Contact</a></li>
    </ul>
  </div>
</nav>
