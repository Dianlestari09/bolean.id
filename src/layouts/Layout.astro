---
import '../styles/global.css';
import LanguagePicker from '../components/LanguagePicker.astro';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const { 
	title = 'Bolean | Layanan Teknologi & IT Premium',
	description = 'Bolean menawarkan solusi teknologi mutakhir mulai dari pengembangan aplikasi web, mobile, infrastruktur server, hingga sistem IoT cerdas untuk bisnis Anda.',
	image = '/favicon.svg'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://bolean.id');
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon-tab.png" />
		<link rel="apple-touch-icon" href="/favicon-tab.png" />
		<meta name="generator" content={Astro.generator} />

		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalURL} />

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, canonicalURL)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, canonicalURL)} />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body>
		<slot />

		<!-- Floating WhatsApp Button -->
		<a href="https://wa.me/6281259145879" target="_blank" rel="noopener noreferrer" class="whatsapp-float" aria-label="Chat on WhatsApp">
			<svg viewBox="0 0 24 24" width="34" height="34" fill="white" xmlns="http://www.w3.org/2000/svg">
				<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
			</svg>
		</a>

		<!-- Floating Scroll-To-Top Button -->
		<button id="scrollToTopBtn" class="scroll-to-top" aria-label="Kembali ke atas">
			<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
				<polyline points="18 15 12 9 6 15"></polyline>
			</svg>
		</button>

		<LanguagePicker />

		<!-- Global Smooth UX & Scroll Reveal Script -->
		<script>
			document.addEventListener('DOMContentLoaded', () => {
				// 1. Scroll-To-Top Handler
				const scrollBtn = document.getElementById('scrollToTopBtn');
				if (scrollBtn) {
					window.addEventListener('scroll', () => {
						if (window.scrollY > 350) {
							scrollBtn.classList.add('active');
						} else {
							scrollBtn.classList.remove('active');
						}
					}, { passive: true });

					scrollBtn.addEventListener('click', () => {
						window.scrollTo({
							top: 0,
							behavior: 'smooth'
						});
					});
				}

				// 2. Smooth Scroll Reveal (IntersectionObserver)
				const revealTargets = document.querySelectorAll('.section-header, .service-card, .portfolio-card, .pricing-card, .stat-box, .team-member-card, .home-blog-card, .single-video-card, .faq-item, .cta-banner');
				
				revealTargets.forEach(el => {
					el.classList.add('reveal-on-scroll');
				});

				if ('IntersectionObserver' in window) {
					const observer = new IntersectionObserver((entries) => {
						entries.forEach(entry => {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-revealed');
								observer.unobserve(entry.target);
							}
						});
					}, {
						threshold: 0.05,
						rootMargin: '100px 0px 100px 0px'
					});

					revealTargets.forEach(el => observer.observe(el));
				} else {
					revealTargets.forEach(el => el.classList.add('is-revealed'));
				}

				// 3. Smooth Internal Link Scrolling
				document.querySelectorAll('a[href^="#"]').forEach(anchor => {
					anchor.addEventListener('click', (e) => {
						const href = anchor.getAttribute('href');
						if (href && href !== '#') {
							const target = document.querySelector(href);
							if (target) {
								e.preventDefault();
								target.scrollIntoView({
									behavior: 'smooth'
								});
							}
						}
					});
				});

				// 4. Table of Contents Toggle Handler
				const tocToggle = document.getElementById('toc-toggle');
				const tocList = document.getElementById('toc-list');
				const tocStatusText = document.getElementById('toc-status-text');
				const tocToggleBtn = document.querySelector('.toc-toggle-btn');

				if (tocToggle && tocList && tocStatusText) {
					tocToggle.addEventListener('click', () => {
						const isCollapsed = tocList.classList.toggle('collapsed');
						if (tocToggleBtn) {
							tocToggleBtn.classList.toggle('collapsed', isCollapsed);
						}
						tocStatusText.textContent = isCollapsed ? 'Tampilkan' : 'Sembunyikan';
					});
				}
			});
		</script>

	</body>
</html>

