---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Services | Bolean">
  <Navbar />
  <main style="min-height: calc(100vh - 80px); padding-top: 80px;">
    <section class="section section-light">
      <div class="container">
        <div class="section-header">
          <span class="section-subtitle">Apa Yang Kami Lakukan</span>
          <h2 class="section-title">Layanan IT Eksklusif</h2>
        </div>
        
        <div class="services-grid">
          <div class="service-card">
            <div class="service-icon" style="width: 3rem; height: 3rem; margin-bottom: 1.5rem; color: var(--color-primary);"><Icon name="monitor" class="" /></div>
            <h3 class="service-title">Pengembangan Web</h3>
            <p class="service-desc">Website yang bersih, responsif, dan berperforma tinggi yang disesuaikan dengan kebutuhan bisnis unik Anda.</p>
          </div>
          <div class="service-card">
            <div class="service-icon" style="width: 3rem; height: 3rem; margin-bottom: 1.5rem; color: var(--color-primary);"><Icon name="smartphone" class="" /></div>
            <h3 class="service-title">Desain Aplikasi</h3>
            <p class="service-desc">Desain UI/UX intuitif yang memberikan pengalaman menarik dan mulus bagi pengguna ponsel Anda.</p>
          </div>
          <div class="service-card">
            <div class="service-icon" style="width: 3rem; height: 3rem; margin-bottom: 1.5rem; color: var(--color-primary);"><Icon name="globe" class="" /></div>
            <h3 class="service-title">Arsitektur Cloud</h3>
            <p class="service-desc">Infrastruktur cloud yang aman dan terukur untuk memastikan aplikasi Anda berjalan lancar 24/7.</p>
          </div>
          <div class="service-card">
            <div class="service-icon" style="width: 3rem; height: 3rem; margin-bottom: 1.5rem; color: var(--color-primary);"><Icon name="shield-check" class="" /></div>
            <h3 class="service-title">Keamanan Siber</h3>
            <p class="service-desc">Audit dan solusi keamanan komprehensif untuk melindungi data bisnis berharga Anda.</p>
          </div>
          <div class="service-card">
            <div class="service-icon" style="width: 3rem; height: 3rem; margin-bottom: 1.5rem; color: var(--color-primary);"><Icon name="bar-chart" class="" /></div>
            <h3 class="service-title">Analisis Data</h3>
            <p class="service-desc">Ubah data mentah Anda menjadi wawasan yang dapat ditindaklanjuti untuk keputusan bisnis yang lebih baik.</p>
          </div>
          <div class="service-card">
            <div class="service-icon" style="width: 3rem; height: 3rem; margin-bottom: 1.5rem; color: var(--color-primary);"><Icon name="zap" class="" /></div>
            <h3 class="service-title">Pemasaran Digital</h3>
            <p class="service-desc">Strategi berbasis data untuk meningkatkan kehadiran online dan menjangkau audiens target Anda.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
