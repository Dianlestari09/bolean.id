---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { allProjects } from '../data/projects.js';
import { customerLogos } from '../data/customers.js';

// Gunakan seluruh dataset portofolio agar mencakup Software, Hardware, dan IoT
const featuredProjects = allProjects;
---

<Layout title="Bolean.id - Solusi IT, Software, Hardware & IoT Premium" description="Bolean menyediakan solusi teknologi terpadu: pengembangan software kustom, infrastruktur hardware, dan integrasi IoT cerdas untuk mempercepat pertumbuhan bisnis Anda.">
  <Navbar />
  
  <main style="padding-top: 80px;">
    
    <!-- =========================================================================
         1. HERO SECTION
         ========================================================================= -->
    <section class="hero" style="padding-top: 2rem; min-height: calc(100vh - 80px);">
      <div class="container">
        <div class="hero-content">
          <span class="hero-subtitle">SOLUSI IT & TEKNOLOGI TERPERCAYA</span>
          <h1 class="hero-title">
            Solusi IT &<br/>Layanan <span>Teknologi</span> Cerdas
          </h1>
          <p class="hero-description">
            Mitra teknologi terpercaya untuk mempercepat pertumbuhan bisnis Anda. Kami menghadirkan solusi pembuatan software, website modern, sistem IoT, hardware, serta integrasi AI & otomasi alur kerja yang tangguh dan terukur.
          </p>
          <div class="hero-buttons">
            <a href="/services" class="btn btn-primary">Layanan Kami</a>
            <a href="#contact-section" class="btn btn-secondary">Konsultasi Gratis</a>
          </div>
        </div>
        <div class="hero-image">
          <!-- Floating Badge: Proyek Selesai (Tetap Ada) -->
          <div class="hero-floating-badge hero-badge-top-left">
            <div class="hero-badge-icon badge-icon-teal">🚀</div>
            <div>
              <div class="hero-badge-subtitle">Proyek Selesai</div>
              <div class="hero-badge-title">120+ Klien Puas</div>
            </div>
          </div>

          <!-- Floating Badge: Technology (Kontainer Sendiri, Tanpa Icon) -->
          <div class="hero-floating-badge hero-badge-top-right">
            <div class="hero-badge-title" style="font-size: 1rem; font-weight: 800; color: #082752;">Technology</div>
          </div>

          <!-- Floating Badge: Terpercaya (Kontainer Sendiri, Tanpa Icon) -->
          <div class="hero-floating-badge hero-badge-bottom-left">
            <div class="hero-badge-title" style="font-size: 1rem; font-weight: 800; color: #082752;">Terpercaya</div>
          </div>

          <!-- Floating Badge: Garansi Kepuasan (Kontainer Sendiri, Tanpa Icon) -->
          <div class="hero-floating-badge hero-badge-bottom-right">
            <div class="hero-badge-title" style="font-size: 1rem; font-weight: 800; color: #082752;">Garansi Kepuasan</div>
          </div>

          <!-- PLACEHOLDER GAMBAR HERO / MASKOT BOLEAN -->
          <img 
            src="/images/maskot-bolean-transparent2.png" 
            alt="Bolean Mascot" 
            class="hero-mascot-img"
          />
        </div>

      </div>
    </section>



    <!-- =========================================================================
         2. LOGO CUSTOMER & TECH STACK MARQUEE
         ========================================================================= -->
    <section class="marquee-section">
      <div class="container">
        <p class="marquee-title">Dipercaya Oleh Berbagai Bisnis & Institusi Terkemuka</p>
      </div>
      <div class="marquee-track">
        <!-- CUSTOMER LOGO ITEMS (Duplikasi otomatis untuk looping animasi marquee yang mulus) -->
        {[...customerLogos, ...customerLogos].map((client) => (
          <div class="marquee-item">
            <img src={client.logo} alt={client.name} loading="lazy" />
            <span>{client.name}</span>
          </div>
        ))}
      </div>
    </section>


    <!-- =========================================================================
         3. ABOUT US SECTION
         ========================================================================= -->
    <section class="section section-gray" id="about-section">
      <div class="container">
        <div class="about-grid">
          <div class="about-image-wrapper">
            <div class="about-image-box" style="display: flex; align-items: center; justify-content: center; background: linear-gradient(145deg, #082752, #0c3875); padding: 2rem; position: relative;">
              <!-- PLACEHOLDER GAMBAR ABOUT US -->
              <img 
                src="/images/maskot-bolean-transparent2.png" 
                alt="Tentang Bolean" 
                style="max-height: 380px; width: auto; object-fit: contain; filter: drop-shadow(0 15px 25px rgba(0,0,0,0.3));" 
              />
              <div style="position: absolute; bottom: 20px; left: 20px; background: rgba(13, 168, 158, 0.95); color: white; padding: 1rem 1.5rem; border-radius: 12px; backdrop-filter: blur(8px); box-shadow: 0 10px 25px rgba(0,0,0,0.15);">
                <div style="font-size: 1.6rem; font-weight: 800; line-height: 1;">5+ Tahun</div>
                <div style="font-size: 0.85rem; font-weight: 600;">Dedikasi Solusi IT</div>
              </div>
            </div>
          </div>
          
          <div class="about-content">
            <span class="section-subtitle">TENTANG BOLEAN</span>
            <h2 class="section-title">Menghubungkan Kompleksitas Bisnis dengan Solusi Nyata</h2>
            <p style="color: var(--color-text-muted); margin-bottom: 1.25rem;">
              Di Bolean, kami menyederhanakan hal yang rumit. Kami menghilangkan kerumitan teknis dan berfokus pada hasil: menghadirkan sistem teknologi yang tangguh, aman, dan siap bertumbuh bersama bisnis Anda.
            </p>
            <p style="color: var(--color-text-muted); margin-bottom: 2rem;">
              Berpusat di Kota Malang, tim ahli kami memadukan arsitektur perangkat lunak modern, keahlian perangkat keras enterprise, dan inovasi IoT untuk memberikan nilai tambah kompetitif bagi setiap mitra.
            </p>
            
            <div class="about-features">
              <div class="feature-item">
                <span class="feature-icon">✓</span> Tim Ahli & Berpengalaman
              </div>
              <div class="feature-item">
                <span class="feature-icon">✓</span> Arsitektur Kode Bersih
              </div>
              <div class="feature-item">
                <span class="feature-icon">✓</span> Dukungan & Maintenance 24/7
              </div>
              <div class="feature-item">
                <span class="feature-icon">✓</span> Pengiriman Tepat Waktu
              </div>
            </div>
            
            <div style="margin-top: 2.5rem; display: flex; gap: 1rem; align-items: center;">
              <a href="/about" class="btn btn-primary">Pelajari Lebih Lanjut</a>
              <a href="/contact" class="btn btn-secondary">Hubungi Kami</a>
            </div>
          </div>
        </div>

        <!-- Stats Counter -->
        <div class="stats-grid">
          <div class="stat-box">
            <div class="stat-number">120<span>+</span></div>
            <div class="stat-label">Proyek Sukses Dikerjakan</div>
          </div>
          <div class="stat-box">
            <div class="stat-number">98<span>%</span></div>
            <div class="stat-label">Tingkat Kepuasan Klien</div>
          </div>
          <div class="stat-box">
            <div class="stat-number">99.9<span>%</span></div>
            <div class="stat-label">Uptime Infrastruktur Server</div>
          </div>
          <div class="stat-box">
            <div class="stat-number">24<span>/7</span></div>
            <div class="stat-label">Dukungan Teknis & Konsultasi</div>
          </div>
        </div>
      </div>
    </section>


    <!-- =========================================================================
         4. SERVICES SECTION (3 PILAR BISNIS)
         ========================================================================= -->
    <section class="section section-light" id="services-section">
      <div class="container">
        <div class="section-header">
          <span class="section-subtitle">LAYANAN UNGGULAN</span>
          <h2 class="section-title">Layanan IT Terpadu untuk Masa Depan Bisnis Anda</h2>
          <p style="color: var(--color-text-muted); margin-top: 0.5rem;">
            Solusi end-to-end mulai dari digitalisasi aplikasi, pengadaan infrastruktur fisik, hingga otomasi pintar.
          </p>
        </div>
        
        <div class="services-grid">
          <!-- Service 1: Custom Software -->
          <div class="service-card" id="custom-software">
            <div class="service-icon"><Icon name="monitor" class="" /></div>
            <h3 class="service-title">Pembuatan Custom Software</h3>
            <p class="service-desc">
              Pengembangan aplikasi perangkat lunak kustom, sistem ERP, CRM, dan aplikasi mobile berperforma tinggi dengan standar UX modern sesuai kebutuhan bisnis Anda.
            </p>
            <div style="margin-top: 1.5rem;">
              <a href="/services/software" style="font-weight: 700; color: var(--color-primary); display: inline-flex; align-items: center; gap: 0.3rem;">
                Lihat Detail Software →
              </a>
            </div>
          </div>
          
          <!-- Service 2: Hardware -->
          <div class="service-card" id="hardware">
            <div class="service-icon"><Icon name="hard-drive" class="" /></div>
            <h3 class="service-title">Pembuatan Hardware</h3>
            <p class="service-desc">
              Perancangan skematik & PCB kustom, arsitektur server, instalasi jaringan fiber/LAN enterprise, serta perakitan workstation andal.
            </p>
            <div style="margin-top: 1.5rem;">
              <a href="/services/hardware" style="font-weight: 700; color: var(--color-primary); display: inline-flex; align-items: center; gap: 0.3rem;">
                Lihat Detail Hardware →
              </a>
            </div>
          </div>
          
          <!-- Service 3: IoT -->
          <div class="service-card" id="iot">
            <div class="service-icon"><Icon name="cpu" class="" /></div>
            <h3 class="service-title">Pembuatan IoT</h3>
            <p class="service-desc">
              Integrasi sensor telemetri real-time, gateway LoRaWAN/MQTT, sistem otomasi industri, dan dashboard monitoring cerdas terintegrasi.
            </p>
            <div style="margin-top: 1.5rem;">
              <a href="/services/iot" style="font-weight: 700; color: var(--color-primary); display: inline-flex; align-items: center; gap: 0.3rem;">
                Lihat Detail IoT →
              </a>
            </div>
          </div>

          <!-- Service 4: Website -->
          <div class="service-card" id="website">
            <div class="service-icon"><Icon name="globe" class="" /></div>
            <h3 class="service-title">Pembuatan Website</h3>
            <p class="service-desc">
              Website profil perusahaan, landing page, dan portal bisnis secepat kilat dengan arsitektur modern, responsif, dan skor SEO 100/100.
            </p>
            <div style="margin-top: 1.5rem;">
              <a href="/services/software/web" style="font-weight: 700; color: var(--color-primary); display: inline-flex; align-items: center; gap: 0.3rem;">
                Lihat Detail Website →
              </a>
            </div>
          </div>

          <!-- Service 5: Pengelolaan Website -->
          <div class="service-card" id="pengelolaan-website">
            <div class="service-icon"><Icon name="shield-check" class="" /></div>
            <h3 class="service-title">Pengelolaan Website</h3>
            <p class="service-desc">
              Layanan pemeliharaan berkala, update konten, optimasi kecepatan server, backup rutin otomatis, audit keamanan siber, dan monitoring 24/7.
            </p>
            <div style="margin-top: 1.5rem;">
              <a href="/contact" style="font-weight: 700; color: var(--color-primary); display: inline-flex; align-items: center; gap: 0.3rem;">
                Konsultasi Pengelolaan →
              </a>
            </div>
          </div>

          <!-- Service 6: Otomasi & AI Bisnis -->
          <div class="service-card" id="otomasi-ai">
            <div class="service-icon"><Icon name="bot" class="" /></div>
            <h3 class="service-title">Otomasi & AI Bisnis</h3>
            <p class="service-desc">
              Integrasi kecerdasan buatan (AI), chatbot WhatsApp otomatis 24/7, dan otomatisasi alur kerja untuk memangkas tugas manual repetitif.
            </p>
            <div style="margin-top: 1.5rem;">
              <a href="/contact" style="font-weight: 700; color: var(--color-primary); display: inline-flex; align-items: center; gap: 0.3rem;">
                Konsultasi AI & Otomasi →
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- =========================================================================
         5. FEATURED PORTFOLIO / CASE STUDIES (4 Desktop / 2 Mobile per Kategori)
         ========================================================================= -->
    <section class="section section-gray" id="portfolio-section">
      <div class="container">
        <div class="section-header">
          <span class="section-subtitle">KARYA TERBAIK KAMI</span>
          <h2 class="section-title">Portofolio & Studi Kasus Proyek</h2>
          <p style="color: var(--color-text-muted); margin-top: 0.5rem;">
            Lihat bagaimana kami membantu berbagai industri bertransformasi melalui solusi teknologi yang presisi.
          </p>
        </div>

        <!-- Filter Tabs (Hanya Software, Hardware, dan IoT) -->
        <div class="portfolio-tabs">
          <button class="portfolio-tab-btn active" data-filter="Software">Software</button>
          <button class="portfolio-tab-btn" data-filter="Hardware">Hardware</button>
          <button class="portfolio-tab-btn" data-filter="IoT">IoT</button>
        </div>


        <!-- Portfolio Cards Grid -->
        <div class="portfolio-grid" id="portfolioGrid">
          {featuredProjects.map((project) => (
            <div class="portfolio-card" data-category={project.category}>
              <div class="portfolio-thumb">
                <!-- PLACEHOLDER GAMBAR PORTOFOLIO -->
                <img src={project.image} alt={project.title} loading="lazy" />
                <span class="portfolio-badge">{project.category}</span>
              </div>
              <div class="portfolio-body">
                <h3 class="portfolio-title">{project.title}</h3>
                <p class="portfolio-desc">{project.description}</p>
                <div class="portfolio-tags">
                  {project.technologies?.slice(0, 3).map((tech) => (
                    <span class="portfolio-tag">{tech}</span>
                  ))}
                </div>
                <a href={`/projects/${project.slug}`} class="portfolio-link">
                  Lihat Detail Kasus <span>→</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>


    <!-- =========================================================================
         6. PRICING & SERVICE PACKAGES
         ========================================================================= -->
    <section class="section section-light" id="pricing-section">
      <div class="container container-pricing">
        <div class="section-header">
          <span class="section-subtitle">TRANSPARANSI BIAYA</span>
          <h2 class="section-title">Paket Layanan Fleksibel Sesuai Kebutuhan</h2>
          <p style="color: var(--color-text-muted); margin-top: 0.5rem;">
            Pilih paket yang paling cocok untuk mempercepat pertumbuhan dan digitalisasi bisnis Anda.
          </p>
        </div>

        <!-- Pricing Category Tabs -->
        <div class="pricing-tabs-wrapper">
          <div class="pricing-tabs">
            <button class="pricing-tab-btn active" data-pricing-tab="popular">
              ⭐ Paling Populer
            </button>
            <button class="pricing-tab-btn" data-pricing-tab="software">
              Website & Software
            </button>
            <button class="pricing-tab-btn" data-pricing-tab="hardware">
              Hardware & IoT
            </button>
          </div>
        </div>

        <div class="pricing-grid">
          <!-- Package 1: Pembuatan Website (Populer, Software) -->
          <div class="pricing-card featured" data-pricing-category="popular software" style="display: flex;">
            <span class="popular-badge">Paling Populer</span>
            <div class="pricing-header">
              <h3 class="pricing-tier">Pembuatan Website</h3>
              <div class="pricing-price">Mulai Rp 750 Rb</div>
              <p class="pricing-desc">Cocok untuk Landing Page, Portofolio & Company Profile Bisnis</p>
            </div>
            <ul class="pricing-features">
              <li class="pricing-feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Desain Modern, Cepat & Responsif
              </li>
              <li class="pricing-feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Integrasi Form Kontak & WhatsApp
              </li>
              <li class="pricing-feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Arsitektur Ringan (Astro/HTML5)
              </li>
              <li class="pricing-feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Optimasi SEO & Google Search Ready
              </li>
              <li class="pricing-feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Garansi & Setup Domain/Hosting
              </li>
            </ul>
            <a href="https://wa.me/6281259145879?text=Halo%20Bolean,%20saya%20tertarik%20dengan%20Paket%20Pembuatan%20Website%20(Mulai%20750rb)" target="_blank" class="btn btn-primary pricing-cta">Pilih Paket Website</a>
          </div>

          <!-- Package 2: Pembuatan Aplikasi Custom (Populer, Software) -->
          <div class="pricing-card featured" data-pricing-category="popular software" style="display: flex;">
            <span class="popular-badge">Paling Populer</span>
            <div class="pricing-header">
              <h3 class="pricing-tier">Pembuatan Aplikasi Custom</h3>
              <div class="pricing-price">Mulai Rp 1 Jt</div>
              <p class="pricing-desc">Solusi Aplikasi Web, Mobile App & Sistem Internal Bisnis</p>
            </div>
            <ul class="pricing-features">
              <li class="pricing-feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Fitur & Alur Kerja Kustom Bisnis
              </li>
              <li class="pricing-feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Dashboard Admin & Database Terpadu
              </li>
              <li class="pricing-feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Manajemen Pengguna & Autentikasi
              </li>
              <li class="pricing-feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Multi-Platform (Web / Android / iOS)
              </li>
              <li class="pricing-feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Garansi & Dukungan Teknis Penuh
              </li>
            </ul>
            <a href="https://wa.me/6281259145879?text=Halo%20Bolean,%20saya%20ingin%20membuat%20Aplikasi%20Custom%20(Mulai%201%20Juta)" target="_blank" class="btn btn-primary pricing-cta">Pesan Aplikasi Custom</a>
          </div>

          <!-- Package 3: Pembuatan Sistem IoT (Populer, Hardware) -->
          <div class="pricing-card" data-pricing-category="popular hardware" style="display: flex;">
            <div class="pricing-header">
              <h3 class="pricing-tier">Pembuatan Sistem IoT</h3>
              <div class="pricing-price">Mulai Rp 1.5 Jt</div>
              <p class="pricing-desc">Sensor Pintar, Telemetri Real-Time & Cloud Monitoring</p>
            </div>
            <ul class="pricing-features">
              <li class="pricing-feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Integrasi Sensor Fisik Real-Time
              </li>
              <li class="pricing-feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Protokol LoRaWAN / WiFi / MQTT
              </li>
              <li class="pricing-feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Dashboard Monitoring & Kontrol Cloud
              </li>
              <li class="pricing-feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Sistem Notifikasi Alarm Otomatis
              </li>
              <li class="pricing-feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Logging Data & Analisis Grafik
              </li>
            </ul>
            <a href="https://wa.me/6281259145879?text=Halo%20Bolean,%20saya%20ingin%20konsultasi%20Sistem%20IoT%20(Mulai%201.5%20Juta)" target="_blank" class="btn btn-primary pricing-cta">Konsultasi Sistem IoT</a>
          </div>

          <!-- Package 4: Pembuatan Alat & Otomasi Hardware (Hardware) -->
          <div class="pricing-card" data-pricing-category="hardware" style="display: none;">
            <div class="pricing-header">
              <h3 class="pricing-tier">Pembuatan Alat & Otomasi Hardware</h3>
              <div class="pricing-price">Mulai Rp 750 Rb</div>
              <p class="pricing-desc">Desain PCB, Controller & Alat Otomasi Khusus</p>
            </div>
            <ul class="pricing-features">
              <li class="pricing-feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Desain Skematik & Fabrikasi PCB
              </li>
              <li class="pricing-feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Pemrograman Microcontroller Kustom
              </li>
              <li class="pricing-feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Integrasi Relay, Motor & Aktuator
              </li>
              <li class="pricing-feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Perakitan Komponen & Casing Rapi
              </li>
              <li class="pricing-feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Pengujian Alat & Dokumentasi Lengkap
              </li>
            </ul>
            <a href="https://wa.me/6281259145879?text=Halo%20Bolean,%20saya%20tertarik%20dengan%20Pembuatan%20Alat%20Otomasi%20Hardware%20(Mulai%20750rb)" target="_blank" class="btn btn-secondary pricing-cta">Pesan Alat Otomasi</a>
          </div>

          <!-- Package 5: Pengelolaan Website (Software) -->
          <div class="pricing-card" data-pricing-category="software" style="display: none;">
            <div class="pricing-header">
