---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact Us | Bolean">
  <Navbar />
  <main style="min-height: calc(100vh - 80px); padding-top: 80px;">
    <section class="section section-light" style="min-height: calc(100vh - 80px);">
      <div class="container">
        <div class="section-header">
          <span class="section-subtitle">Hubungi Kami</span>
          <h2 class="section-title">Mari Bekerja Sama</h2>
        </div>
        
        <div class="contact-grid">
          <div class="contact-info">
            <h3>Hubungi Kami</h3>
            <div class="info-item">
              <div class="info-icon">📍</div>
              <div class="info-text">
                <h4>Lokasi Kami</h4>
                <p>Kota Malang, Indonesia</p>
              </div>
            </div>
            <div class="info-item">
              <div class="info-icon">📧</div>
              <div class="info-text">
                <h4>Email Kami</h4>
                <p>infobolean.id@gmail.com</p>
              </div>
            </div>
            <div class="info-item">
              <div class="info-icon">📞</div>
              <div class="info-text">
                <h4>Telepon Kami</h4>
                <p>+62 812-5914-5879</p>
              </div>
            </div>
          </div>
          
          <div class="contact-form-wrapper">
            <div id="form-success" class="text-center py-8" style="display: none;">
              <h3 style="color: var(--color-primary); margin-bottom: 1rem;">Pesan Terkirim!</h3>
              <p>Kami akan segera menghubungi Anda kembali.</p>
              <button id="btn-reset" class="btn btn-secondary" style="margin-top: 2rem;">Kirim Lagi</button>
            </div>
            
            <form id="contact-form">
              <div class="form-group">
                <input 
                  type="text" 
                  id="form-name"
                  class="form-control" 
                  placeholder="Nama Anda" 
                  required 
                />
              </div>
              <div class="form-group">
                <input 
                  type="email" 
                  id="form-email"
                  class="form-control" 
                  placeholder="Alamat Email" 
                  required 
                />
              </div>
              <div class="form-group">
                <textarea 
                  id="form-message"
                  class="form-control" 
                  placeholder="Bagaimana kami bisa membantu Anda?" 
                  required
                ></textarea>
              </div>
              <button type="submit" id="btn-submit" class="btn btn-primary">
                Kirim Pesan
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form');
    const successMsg = document.getElementById('form-success');
    const btnSubmit = document.getElementById('btn-submit');
    const btnReset = document.getElementById('btn-reset');

    if (form && successMsg && btnSubmit && btnReset) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        // Disable button
        btnSubmit.textContent = 'Mengirim...';
        btnSubmit.setAttribute('disabled', 'true');
        
        // Simulate API call to Supabase
        await new Promise(resolve => setTimeout(resolve, 1000));
        
        // Show success
        form.style.display = 'none';
        successMsg.style.display = 'block';
        
        // Reset form
        (form as HTMLFormElement).reset();
        
        // Reset button
        btnSubmit.textContent = 'Kirim Pesan';
        btnSubmit.removeAttribute('disabled');
      });

      btnReset.addEventListener('click', () => {
        successMsg.style.display = 'none';
        form.style.display = 'block';
      });
    }
  });
</script>
