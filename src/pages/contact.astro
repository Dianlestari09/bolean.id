---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact Us | Bolean">
  <Navbar />
  <main style="min-height: calc(100vh - 80px); padding-top: 80px;">
    <section class="section section-light" style="min-height: calc(100vh - 80px);">
      <div class="container">
        <div class="section-header">
          <span class="section-subtitle">Hubungi Kami</span>
          <h2 class="section-title">Mari Bekerja Sama</h2>
        </div>
        
        <div class="contact-grid">
          <div class="contact-info">
            <h3>Hubungi Kami</h3>
            
            <div class="info-item">
              <div class="info-icon-box">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div class="info-text">
                <h4>Lokasi Kami</h4>
                <p>Kota Malang, Jawa Timur, Indonesia</p>
              </div>
            </div>

            <div class="info-item">
              <div class="info-icon-box">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
              </div>
              <div class="info-text">
                <h4>Email Kami</h4>
                <p><a href="mailto:infobolean.id@gmail.com">infobolean.id@gmail.com</a></p>
              </div>
            </div>

            <div class="info-item">
              <div class="info-icon-box">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
              </div>
              <div class="info-text">
                <h4>Telepon / WhatsApp</h4>
                <p><a href="https://wa.me/6281259145879" target="_blank" rel="noopener noreferrer">+62 812-5914-5879</a></p>
              </div>
            </div>

            <div class="info-item">
              <div class="info-icon-box">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              </div>
              <div class="info-text">
                <h4>Jam Operasional</h4>
                <p>Senin - Sabtu: 08.00 - 17.00 WIB</p>
              </div>
            </div>
          </div>

          
          <div class="contact-form-wrapper">
            <div id="form-success" class="text-center py-8" style="display: none; padding: 2.25rem 2rem; background: #f0fdfa; border-radius: 16px; border: 1.5px solid var(--color-primary); margin-bottom: 1.5rem;">
              <div style="width: 56px; height: 56px; border-radius: 50%; background: #22c55e; color: white; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 1rem; box-shadow: 0 4px 14px rgba(34, 197, 94, 0.35);">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <h3 style="color: var(--color-secondary); font-size: 1.4rem; font-weight: 800; margin-bottom: 0.5rem;">Pesan Diteruskan ke WhatsApp!</h3>
              <p style="color: #475569; font-size: 0.95rem; line-height: 1.55; max-width: 440px; margin: 0 auto 1.5rem auto;">
                Aplikasi WhatsApp Anda telah dibuka secara otomatis dengan format pesan yang sudah disiapkan. Jika belum terbuka otomatis, silakan klik tombol hijau di bawah ini:
              </p>
              <a id="wa-direct-btn" href="#" target="_blank" class="btn btn-primary" style="background: #22c55e; border-color: #22c55e; font-weight: 700; display: inline-flex; align-items: center; gap: 8px; padding: 0.8rem 1.6rem; border-radius: 50px; text-decoration: none; box-shadow: 0 4px 14px rgba(34, 197, 94, 0.3);">
                <span>Buka Chat WhatsApp Sekarang</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </a>
              <div style="margin-top: 1.5rem;">
                <button id="btn-reset" class="btn btn-secondary" style="font-size: 0.88rem; padding: 0.6rem 1.25rem;">Kirim Pesan Lainnya</button>
              </div>
            </div>
            
            <form id="contact-form">
              <div class="form-group">
                <input 
                  type="text" 
                  id="form-name"
                  class="form-control" 
                  placeholder="Nama Anda" 
                  required 
                />
              </div>
              <div class="form-group">
                <input 
                  type="email" 
                  id="form-email"
                  class="form-control" 
                  placeholder="Alamat Email" 
                  required 
                />
              </div>
              <div class="form-group">
                <textarea 
                  id="form-message"
                  class="form-control" 
                  placeholder="Bagaimana kami bisa membantu Anda?" 
                  required
                ></textarea>
              </div>
              <button type="submit" id="btn-submit" class="btn btn-primary">
                Kirim Pesan
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form');
    const successMsg = document.getElementById('form-success');
    const btnSubmit = document.getElementById('btn-submit');
    const btnReset = document.getElementById('btn-reset');

    if (form && successMsg && btnSubmit && btnReset) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        
        const nameInput = document.getElementById('form-name') as HTMLInputElement | null;
        const emailInput = document.getElementById('form-email') as HTMLInputElement | null;
        const msgInput = document.getElementById('form-message') as HTMLTextAreaElement | null;
        const waDirectBtn = document.getElementById('wa-direct-btn') as HTMLAnchorElement | null;

        const name = nameInput ? nameInput.value.trim() : '';
        const email = emailInput ? emailInput.value.trim() : '';
        const message = msgInput ? msgInput.value.trim() : '';

        // Nomor WhatsApp Admin Bolean
        const waNumber = '6281259145879';
        
        // Format pesan WhatsApp yang rapi dan terstruktur
        const text = `Halo Bolean.id, saya ingin berkonsultasi mengenai kebutuhan teknologi/proyek.\n\n*Nama:* ${name}\n*Email:* ${email}\n*Pesan:*\n${message}\n\n(Terkirim melalui formulir kontak bolean.id)`;
        
        const waUrl = `https://wa.me/${waNumber}?text=${encodeURIComponent(text)}`;

        // Update tombol chat di kotak pesan sukses
        if (waDirectBtn) {
          waDirectBtn.href = waUrl;
        }

        // Buka WhatsApp di tab baru
        window.open(waUrl, '_blank');

        // Tampilkan pesan konfirmasi sukses di halaman
        form.style.display = 'none';
        successMsg.style.display = 'block';

        // Reset form
        (form as HTMLFormElement).reset();
      });

      btnReset.addEventListener('click', () => {
        successMsg.style.display = 'none';
        form.style.display = 'block';
      });
    }
  });
</script>
