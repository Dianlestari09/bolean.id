---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { allProjects } from '../../data/projects.js';
import { customerLogos } from '../../data/customers.js';

// Helper pemetaan kategori filter
function getCategoryGroup(cat) {
  const c = (cat || '').toLowerCase();
  if (c.includes('mobile')) return 'mobile';
  if (c.includes('web') || c.includes('enterprise') || c.includes('software')) return 'software';
  if (c.includes('iot')) return 'iot';
  if (c.includes('hardware') || c.includes('server') || c.includes('networking') || c.includes('workstation')) return 'hardware';
  return 'other';
}

// 2 Proyek Unggulan untuk Spotlight
const featuredProjects = [
  allProjects.find(p => p.slug === 'industrial-sensors') || allProjects[0],
  allProjects.find(p => p.slug === 'enterprise-erp-system') || allProjects[1]
];

// Hitung total per grup
const counts = {
  all: allProjects.length,
  software: allProjects.filter(p => getCategoryGroup(p.category) === 'software').length,
  mobile: allProjects.filter(p => getCategoryGroup(p.category) === 'mobile').length,
  iot: allProjects.filter(p => getCategoryGroup(p.category) === 'iot').length,
  hardware: allProjects.filter(p => getCategoryGroup(p.category) === 'hardware').length,
};
---

<Layout 
  title="Portofolio Project & Studi Kasus | Bolean - Solusi IT & Inovasi Teknologi"
  description="Jelajahi portofolio proyek software custom, aplikasi mobile, sistem enterprise, IoT industri, dan infrastruktur hardware yang telah sukses dikembangkan oleh Bolean."
>
  <Navbar />

  <main class="portfolio-main">

    <!-- =========================================================================
         1. HERO SECTION
         ========================================================================= -->
    <section class="portfolio-hero-section">
      <div class="container">
        <div class="portfolio-hero-content">
          <div class="hero-badge">
            <span class="badge-dot"></span>
            <span>SHOWCASE INOVASI & STUDI KASUS</span>
          </div>
          <h1 class="portfolio-hero-title">
            Karya & Portofolio <span class="text-gradient">Inovasi Teknologi</span>
          </h1>
          <p class="portfolio-hero-desc">
            Dari perancangan arsitektur custom software skala enterprise, aplikasi mobile interaktif, telemetry IoT industri, hingga infrastruktur hardware data center yang tangguh dan teruji.
          </p>

          <!-- Quick Stats Bar -->
          <div class="portfolio-stats-grid">
            <div class="stat-pill">
              <span class="stat-val">{allProjects.length}+</span>
              <span class="stat-lbl">Proyek Beroperasi</span>
            </div>
            <div class="stat-pill">
              <span class="stat-val">100%</span>
              <span class="stat-lbl">Kepuasan Klien</span>
            </div>
            <div class="stat-pill">
              <span class="stat-val">99.9%</span>
              <span class="stat-lbl">Uptime & Stabilitas</span>
            </div>
            <div class="stat-pill">
              <span class="stat-val">4+</span>
              <span class="stat-lbl">Pilar Teknologi</span>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- =========================================================================
         2. FEATURED SPOTLIGHT SHOWCASE (2 PROYEK UNGGULAN)
         ========================================================================= -->
    <section class="portfolio-spotlight-section">
      <div class="container">
        <div class="section-header-left">
          <span class="section-subtitle">CASE STUDY UTAMA</span>
          <h2 class="section-title">Proyek Unggulan Terkini</h2>
          <p class="section-desc">Sorotan inovasi bernilai tinggi yang memberikan dampak operasional dan efisiensi nyata bagi klien kami.</p>
        </div>

        <div class="spotlight-grid">
          {featuredProjects.map((item, idx) => (
            <div class="spotlight-card">
              <div class="spotlight-img-wrap">
                <img src={item.image} alt={item.title} loading="lazy" />
                <span class="spotlight-tag">{item.category}</span>
                <div class="spotlight-badge-num">Spotlight #{idx + 1}</div>
              </div>
              <div class="spotlight-body">
                <h3 class="spotlight-title">{item.title}</h3>
                <p class="spotlight-desc">{item.description}</p>
                
                <div class="spotlight-tech-list">
                  {item.technologies && item.technologies.slice(0, 4).map((tech) => (
                    <span class="tech-chip">{tech}</span>
                  ))}
                </div>

                <div class="spotlight-features">
                  {item.features && item.features.slice(0, 2).map((feat) => (
                    <div class="spotlight-feature-item">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                      <span>{feat}</span>
                    </div>
                  ))}
                </div>

                <div class="spotlight-footer">
                  <a href={`/projects/${item.slug}`} class="btn btn-primary spotlight-btn">
                    <span>Pelajari Detail Proyek</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>


    <!-- =========================================================================
         3. INTERACTIVE FILTER & SEARCH SECTION
         ========================================================================= -->
    <section class="portfolio-list-section" id="koleksi-proyek">
      <div class="container">
        <div class="filter-header-bar">
          <div class="filter-header-text">
            <span class="section-subtitle">SEMUA KARYA</span>
            <h2 class="section-title">Eksplorasi Seluruh Proyek</h2>
            <p class="section-desc">Gunakan pencarian kata kunci atau filter kategori untuk melihat solusi spesifik yang relevan.</p>
          </div>

          <!-- Live Search Box -->
          <div class="search-box-wrapper">
            <div class="search-box">
              <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              <input 
                type="text" 
                id="projectSearchInput" 
                placeholder="Cari proyek (contoh: POS, Telemetri, Mobile, Astro, ERP)..." 
                autocomplete="off"
              />
              <button id="clearSearchBtn" class="clear-search-btn" aria-label="Hapus Pencarian" style="display: none;">&times;</button>
            </div>
          </div>
        </div>

        <!-- Filter Category Tabs -->
        <div class="filter-tabs-container">
          <div class="filter-tabs" role="tablist">
            <button class="filter-tab active" data-filter="all">
              <span>Semua Proyek</span>
              <span class="tab-count">{counts.all}</span>
            </button>
            <button class="filter-tab" data-filter="software">
              <span>Software & Web</span>
              <span class="tab-count">{counts.software}</span>
            </button>
            <button class="filter-tab" data-filter="mobile">
              <span>Aplikasi Mobile</span>
              <span class="tab-count">{counts.mobile}</span>
            </button>
            <button class="filter-tab" data-filter="iot">
              <span>IoT & Otomasi</span>
              <span class="tab-count">{counts.iot}</span>
            </button>
            <button class="filter-tab" data-filter="hardware">
              <span>Hardware & Server</span>
              <span class="tab-count">{counts.hardware}</span>
            </button>
          </div>

          <div class="results-counter" id="resultsCounter">
            Menampilkan <strong id="visibleCount">{allProjects.length}</strong> dari {allProjects.length} Proyek
          </div>
        </div>


        <!-- =========================================================================
             4. PROJECT CARDS GRID
             ========================================================================= -->
        <div class="projects-catalog-grid" id="projectsCatalogGrid">
          {allProjects.map((project) => {
            const group = getCategoryGroup(project.category);
            const searchIndex = [
              project.title, 
              project.category, 
              project.description, 
              ...(project.technologies || []),
              ...(project.features || [])
            ].join(' ').toLowerCase();

            return (
              <article 
                class="project-catalog-card" 
                data-category={group}
                data-search={searchIndex}
              >
                <div class="card-thumb-wrap">
                  <img src={project.image} alt={project.title} loading="lazy" />
                  <span class="card-category-badge">{project.category}</span>
                </div>

                <div class="card-content">
                  <h3 class="card-title">
                    <a href={`/projects/${project.slug}`}>{project.title}</a>
                  </h3>
                  
                  <p class="card-desc">{project.description}</p>

                  <!-- Tech Stack Chips -->
                  <div class="card-tags">
                    {project.technologies && project.technologies.slice(0, 3).map((tech) => (
                      <span class="card-tag">{tech}</span>
                    ))}
                    {project.technologies && project.technologies.length > 3 && (
                      <span class="card-tag card-tag-more">+{project.technologies.length - 3}</span>
                    )}
                  </div>

                  <!-- Key Features -->
                  {project.features && (
                    <div class="card-features">
                      {project.features.slice(0, 2).map((feat) => (
                        <div class="card-feature-item">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                          <span>{feat}</span>
                        </div>
                      ))}
                    </div>
                  )}

                  <!-- Card Footer Action -->
                  <div class="card-action">
                    <a href={`/projects/${project.slug}`} class="card-detail-btn">
                      <span>Detail Proyek</span>
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>

        <!-- Empty State (jika tidak ada hasil pencarian) -->
        <div class="projects-empty-state" id="projectsEmptyState" style="display: none;">
          <div class="empty-icon-wrap">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
          </div>
          <h3 class="empty-title">Proyek Tidak Ditemukan</h3>
          <p class="empty-desc">Tidak ada proyek yang sesuai dengan kata kunci atau filter yang Anda pilih. Silakan coba kata kunci lain.</p>
          <button class="btn btn-secondary" id="resetFiltersBtn">Reset Filter & Pencarian</button>
        </div>
      </div>
    </section>


    <!-- =========================================================================
         5. TRUSTED CLIENTS STRIP
         ========================================================================= -->
    <section class="portfolio-clients-strip">
      <div class="container">
        <p class="clients-strip-title">Dipercaya Oleh Berbagai Perusahaan & Institusi Nasional</p>
        <div class="clients-strip-grid">
          {customerLogos.map((client) => (
            <div class="strip-client-item" title={client.name}>
              <img src={client.logo} alt={client.name} loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    </section>


    <!-- =========================================================================
         6. BOTTOM CTA BANNER
         ========================================================================= -->
    <section class="portfolio-cta-section">
      <div class="container">
        <div class="portfolio-cta-box">
          <div class="cta-glow-effect"></div>
          <div class="portfolio-cta-content">
            <span class="cta-subtitle">KONSULTASI PROYEK ANDA</span>
            <h2 class="cta-title">Siap Membangun Solusi Teknologi Seperti Ini?</h2>
            <p class="cta-desc">
              Diskusikan arsitektur sistem, roadmap pengembangan, serta estimasi biaya proyek software, hardware, IoT, atau otomasi AI bisnis Anda bersama tim kami hari ini.
            </p>
            <div class="cta-actions">
              <a 
                href="https://wa.me/6281259145879?text=Halo%20Bolean,%20saya%20melihat%20halaman%20Portofolio%20dan%20ingin%20konsultasi%20proyek%20baru" 
                target="_blank" 
                class="btn btn-primary cta-btn-main"
              >
                <span>Konsultasi Proyek Gratis</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </a>
              <a href="/contact" class="btn btn-secondary cta-btn-alt">
                Kirim Brief Melalui Kontak
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<!-- Client Script for Interactive Filter & Search -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('projectSearchInput') as HTMLInputElement | null;
    const clearBtn = document.getElementById('clearSearchBtn') as HTMLButtonElement | null;
    const tabs = document.querySelectorAll('.filter-tab');
    const cards = document.querySelectorAll('.project-catalog-card');
    const visibleCountEl = document.getElementById('visibleCount');
    const emptyState = document.getElementById('projectsEmptyState');
    const resetBtn = document.getElementById('resetFiltersBtn');

    let currentFilter = 'all';
    let searchQuery = '';

    function filterProjects() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const el = card as HTMLElement;
        const category = el.getAttribute('data-category') || '';
        const searchData = el.getAttribute('data-search') || '';

        const matchesCategory = (currentFilter === 'all' || category === currentFilter);
        const matchesSearch = !searchQuery || searchData.includes(searchQuery);

        if (matchesCategory && matchesSearch) {
          el.style.display = 'flex';
          visibleCount++;
        } else {
          el.style.display = 'none';
        }
      });

      if (visibleCountEl) {
        visibleCountEl.textContent = visibleCount.toString();
      }

      if (emptyState) {
        emptyState.style.display = (visibleCount === 0) ? 'block' : 'none';
      }
    }

    // Category Tabs click
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        currentFilter = tab.getAttribute('data-filter') || 'all';
        filterProjects();
      });
    });

    // Real-time Search Input
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        searchQuery = searchInput.value.trim().toLowerCase();
        if (clearBtn) {
          clearBtn.style.display = searchQuery.length > 0 ? 'inline-block' : 'none';
        }
        filterProjects();
      });
    }

    // Clear search
    if (clearBtn && searchInput) {
      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        searchQuery = '';
        clearBtn.style.display = 'none';
        searchInput.focus();
        filterProjects();
      });
    }

    // Reset button in empty state
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        if (clearBtn) clearBtn.style.display = 'none';
        currentFilter = 'all';
        tabs.forEach((t, idx) => {
          if (idx === 0) t.classList.add('active');
          else t.classList.remove('active');
        });
        filterProjects();
      });
    }
  });
</script>

<style>
  /* Main Portfolio Layout */
  .portfolio-main {
    min-height: calc(100vh - 80px);
    padding-top: 80px;
    background-color: var(--color-background);
  }

  /* 1. Hero Section */
  .portfolio-hero-section {
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    padding: 4.5rem 0 3.5rem 0;
    text-align: center;
    border-bottom: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
  }

  .portfolio-hero-content {
    max-width: 820px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(13, 168, 158, 0.1);
    color: var(--color-primary);
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.4rem 1.1rem;
    border-radius: 50px;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(13, 168, 158, 0.25);
    letter-spacing: 0.04em;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-primary);
    animation: pulseBadge 2s infinite;
  }

  @keyframes pulseBadge {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(13, 168, 158, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(13, 168, 158, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(13, 168, 158, 0); }
  }

  .portfolio-hero-title {
    font-size: 3rem;
    font-weight: 800;
    color: var(--color-secondary);
    line-height: 1.18;
    margin-bottom: 1.25rem;
  }

  .text-gradient {
    background: linear-gradient(135deg, var(--color-primary) 0%, #082752 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .portfolio-hero-desc {
    color: var(--color-text-muted);
    font-size: 1.12rem;
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  .portfolio-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-top: 1rem;
  }

  .stat-pill {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 1.1rem 1rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .stat-pill:hover {
    transform: translateY(-3px);
    border-color: var(--color-primary);
  }

  .stat-val {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.1;
  }

  .stat-lbl {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin-top: 0.35rem;
  }

  /* 2. Featured Spotlight Section */
  .portfolio-spotlight-section {
    padding: 4.5rem 0;
    background: #ffffff;
    border-bottom: 1px solid var(--color-border);
  }

  .section-header-left {
    margin-bottom: 2.5rem;
  }

  .section-desc {
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.6;
    margin-top: 0.4rem;
    max-width: 650px;
  }

  .spotlight-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .spotlight-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
