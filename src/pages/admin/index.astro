  function populateBlogCategoryFilter() {
    const sel = document.getElementById('filter-blog-category') as HTMLSelectElement | null;
    if (!sel) return;
    const cats = Array.from(new Set(currentBlogs.map(b => b.category))).filter(Boolean);
    sel.innerHTML = '<option value="all">Semua Kategori Blog</option>' + 
      cats.map(c => `<option value="${c}">${c}</option>`).join('');
  }

  // Global window functions for modal actions
  (window as any).openEditProject = function(index: number) {
    const p = currentProjects[index];
    if (!p) return;

    (document.getElementById('project-edit-index') as HTMLInputElement).value = index.toString();
    (document.getElementById('modal-project-title') as HTMLElement).textContent = 'Edit Proyek Portofolio';
    (document.getElementById('proj-title') as HTMLInputElement).value = p.title || '';
    (document.getElementById('proj-slug') as HTMLInputElement).value = p.slug || '';
    (document.getElementById('proj-category') as HTMLSelectElement).value = p.category || 'Software - Web';
    (document.getElementById('proj-service-id') as HTMLInputElement).value = p.serviceId || '';
    (document.getElementById('proj-description') as HTMLTextAreaElement).value = p.description || '';
    (document.getElementById('proj-features') as HTMLTextAreaElement).value = p.features ? p.features.join('\n') : '';
    (document.getElementById('proj-technologies') as HTMLInputElement).value = p.technologies ? p.technologies.join(', ') : '';

    if (projDropzoneManager) {
      projDropzoneManager.setImage(p.image || '', p.image ? 'screenshot-proyek.png' : '');
    }

    const modal = document.getElementById('project-modal');
    if (modal) modal.style.display = 'flex';
  };

  (window as any).deleteProject = function(index: number) {
    const p = currentProjects[index];
    if (!p) return;
    if (confirm(`Yakin ingin menghapus proyek "${p.title}"? Perubahan akan langsung tersimpan.`)) {
      currentProjects.splice(index, 1);
      saveProjectsStore();
    }
  };

  (window as any).closeProjectModal = function() {
    const modal = document.getElementById('project-modal');
    if (modal) modal.style.display = 'none';
  };

  (window as any).openEditBlog = function(index: number) {
    const b = currentBlogs[index];
    if (!b) return;

    (document.getElementById('blog-edit-index') as HTMLInputElement).value = index.toString();
    (document.getElementById('modal-blog-title') as HTMLElement).textContent = 'Edit Artikel Blog';
    (document.getElementById('blog-title') as HTMLInputElement).value = b.title || '';
    (document.getElementById('blog-slug') as HTMLInputElement).value = b.slug || '';
    
    // 1. Kategori Dropdown
    const catSelect = document.getElementById('blog-category') as HTMLSelectElement | null;
    if (catSelect) {
      const exists = Array.from(catSelect.options).some(o => o.value === b.category);
      if (!exists && b.category) {
        const opt = document.createElement('option');
        opt.value = b.category;
        opt.textContent = b.category;
        catSelect.appendChild(opt);
      }
      catSelect.value = b.category || 'Cloud & Infrastructure';
    }

    // 2. Tanggal Kalender
    const datePicker = document.getElementById('blog-date-picker') as HTMLInputElement | null;
    const dateHidden = document.getElementById('blog-date') as HTMLInputElement | null;
    const datePreview = document.getElementById('blog-date-formatted-preview');

    const isoDate = parseToIsoDate(b.date || '');
    if (datePicker) {
      datePicker.value = isoDate || new Date().toISOString().split('T')[0];
    }
    if (dateHidden) {
      dateHidden.value = b.date || '';
    }
    if (datePreview) {
      datePreview.textContent = b.date ? `Format rilis: ${b.date}` : '';
    }

    (document.getElementById('blog-read-time') as HTMLInputElement).value = b.readTime || '5 min baca';
    (document.getElementById('blog-excerpt') as HTMLTextAreaElement).value = b.excerpt || '';
    (document.getElementById('blog-tags') as HTMLInputElement).value = b.tags ? b.tags.join(', ') : '';

    // 3. Upload Gambar
    if (blogDropzoneManager) {
      blogDropzoneManager.setImage(b.image || '', b.image ? 'cover-artikel.png' : '');
    }

    const modal = document.getElementById('blog-modal');
    if (modal) modal.style.display = 'flex';
  };

  (window as any).deleteBlog = function(index: number) {
    const b = currentBlogs[index];
    if (!b) return;
    if (confirm(`Yakin ingin menghapus artikel "${b.title}"?`)) {
      currentBlogs.splice(index, 1);
      saveBlogsStore();
    }
  };

  (window as any).closeBlogModal = function() {
    const modal = document.getElementById('blog-modal');
    if (modal) modal.style.display = 'none';
  };

  // Helper for auto-generating slug from title
  function slugify(text: string) {
    return text
      .toString()
      .toLowerCase()
      .trim()
      .replace(/[\s\W-]+/g, '-')
      .replace(/^-+|-+$/g, '');
  }

  // DOM Loaded Event Listener
  document.addEventListener('DOMContentLoaded', () => {
    checkAuth();

    // Initialize Dropzone Managers
    projDropzoneManager = setupDropzone({
      dropzoneId: 'proj-dropzone',
      fileInputId: 'proj-file-input',
      emptyStateId: 'proj-dropzone-empty',
      filledStateId: 'proj-dropzone-filled',
      previewImgId: 'proj-image-preview',
      hiddenInputId: 'proj-image',
      fileNameId: 'proj-file-name',
      changeBtnId: 'btn-change-proj-image',
      removeBtnId: 'btn-remove-proj-image',
      urlToggleBtnId: 'btn-toggle-proj-url',
      urlBoxId: 'proj-url-box',
      urlInputId: 'proj-url-input',
      applyUrlBtnId: 'btn-apply-proj-url'
    });

    blogDropzoneManager = setupDropzone({
      dropzoneId: 'blog-dropzone',
      fileInputId: 'blog-file-input',
      emptyStateId: 'blog-dropzone-empty',
      filledStateId: 'blog-dropzone-filled',
      previewImgId: 'blog-image-preview',
      hiddenInputId: 'blog-image',
      fileNameId: 'blog-file-name',
      changeBtnId: 'btn-change-blog-image',
      removeBtnId: 'btn-remove-blog-image',
      urlToggleBtnId: 'btn-toggle-blog-url',
      urlBoxId: 'blog-url-box',
      urlInputId: 'blog-url-input',
      applyUrlBtnId: 'btn-apply-blog-url'
    });

    // Calendar Date Picker Change Listener
    const blogDatePicker = document.getElementById('blog-date-picker') as HTMLInputElement | null;
    const blogDateHidden = document.getElementById('blog-date') as HTMLInputElement | null;
    const blogDatePreview = document.getElementById('blog-date-formatted-preview');

    if (blogDatePicker && blogDateHidden) {
      blogDatePicker.addEventListener('change', () => {
        const iso = blogDatePicker.value;
        const formatted = formatIndonesianDate(iso);
        blogDateHidden.value = formatted;
        if (blogDatePreview) {
          blogDatePreview.textContent = formatted ? `Format rilis: ${formatted}` : '';
        }
      });
    }

    // Login Form Submit
    const loginForm = document.getElementById('login-form');
    const alertBox = document.getElementById('login-alert');
    const alertText = document.getElementById('login-alert-text');
    const togglePwdBtn = document.getElementById('btn-toggle-pwd');
    const pwdInput = document.getElementById('admin-password') as HTMLInputElement | null;

    if (togglePwdBtn && pwdInput) {
      togglePwdBtn.addEventListener('click', () => {
        pwdInput.type = pwdInput.type === 'password' ? 'text' : 'password';
      });
    }

    if (loginForm) {
      loginForm.addEventListener('submit', () => {
        const emailInput = (document.getElementById('admin-email') as HTMLInputElement).value.trim();
        const passwordInput = (document.getElementById('admin-password') as HTMLInputElement).value;
        const rememberMe = (document.getElementById('remember-me') as HTMLInputElement).checked;

        if (emailInput === 'admin@bolean.id' && passwordInput === 'admin123') {
          if (rememberMe) {
            localStorage.setItem(STORAGE_KEY_AUTH, 'true');
          } else {
            sessionStorage.setItem(STORAGE_KEY_AUTH, 'true');
          }
          if (alertBox) alertBox.style.display = 'none';
          checkAuth();
        } else {
          if (alertBox && alertText) {
            alertText.textContent = 'Email atau kata sandi tidak valid. Gunakan admin@bolean.id / admin123';
            alertBox.style.display = 'flex';
          }
        }
      });
    }

    // Logout Button
    const logoutBtn = document.getElementById('btn-logout');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', () => {
        if (confirm('Apakah Anda yakin ingin keluar dari panel admin?')) {
          localStorage.removeItem(STORAGE_KEY_AUTH);
          sessionStorage.removeItem(STORAGE_KEY_AUTH);
          checkAuth();
        }
      });
    }

    // Navigation Tabs
    const navItems = document.querySelectorAll('.cms-nav-item');
    const tabContents = document.querySelectorAll('.cms-tab-content');
    const tabLabel = document.getElementById('current-tab-label');

    const tabTitles: Record<string, string> = {
      overview: 'Ringkasan',
      projects: 'Manajemen Portofolio Proyek',
      blogs: 'Manajemen Artikel Blog',
      backup: 'Cadangkan & Ekspor Data'
    };

    navItems.forEach(item => {
      item.addEventListener('click', () => {
        const tab = item.getAttribute('data-tab');
        if (!tab) return;

        navItems.forEach(n => n.classList.remove('active'));
        item.classList.add('active');

        tabContents.forEach(c => {
          (c as HTMLElement).style.display = 'none';
        });

        const target = document.getElementById(`tab-${tab}`);
        if (target) target.style.display = 'block';

        if (tabLabel && tabTitles[tab]) {
          tabLabel.textContent = tabTitles[tab];
        }
      });
    });

    // Search and Filter Events
    const projectSearch = document.getElementById('search-project-input');
    const projectFilter = document.getElementById('filter-project-category');
    if (projectSearch) projectSearch.addEventListener('input', renderProjectsTable);
    if (projectFilter) projectFilter.addEventListener('change', renderProjectsTable);

    const blogSearch = document.getElementById('search-blog-input');
    const blogFilter = document.getElementById('filter-blog-category');
    if (blogSearch) blogSearch.addEventListener('input', renderBlogsTable);
    if (blogFilter) blogFilter.addEventListener('change', renderBlogsTable);

    // Auto-generate Slugs
    const projTitleInput = document.getElementById('proj-title') as HTMLInputElement | null;
    const projSlugInput = document.getElementById('proj-slug') as HTMLInputElement | null;
    if (projTitleInput && projSlugInput) {
      projTitleInput.addEventListener('input', () => {
        const editIdx = (document.getElementById('project-edit-index') as HTMLInputElement).value;
        if (editIdx === '-1') {
          projSlugInput.value = slugify(projTitleInput.value);
        }
      });
    }

    const blogTitleInput = document.getElementById('blog-title') as HTMLInputElement | null;
    const blogSlugInput = document.getElementById('blog-slug') as HTMLInputElement | null;
    if (blogTitleInput && blogSlugInput) {
      blogTitleInput.addEventListener('input', () => {
        const editIdx = (document.getElementById('blog-edit-index') as HTMLInputElement).value;
        if (editIdx === '-1') {
          blogSlugInput.value = slugify(blogTitleInput.value);
        }
      });
    }

    // Open Add Modals
    const btnAddProj = document.getElementById('btn-add-project');
    if (btnAddProj) {
      btnAddProj.addEventListener('click', () => {
        (document.getElementById('project-edit-index') as HTMLInputElement).value = '-1';
        (document.getElementById('modal-project-title') as HTMLElement).textContent = 'Tambah Proyek Portofolio Baru';
        (document.getElementById('project-form') as HTMLFormElement).reset();
        if (projDropzoneManager) {
          projDropzoneManager.setImage('');
        }
        const modal = document.getElementById('project-modal');
        if (modal) modal.style.display = 'flex';
      });
    }

    const btnAddBlog = document.getElementById('btn-add-blog');
    if (btnAddBlog) {
      btnAddBlog.addEventListener('click', () => {
        (document.getElementById('blog-edit-index') as HTMLInputElement).value = '-1';
        (document.getElementById('modal-blog-title') as HTMLElement).textContent = 'Tulis Artikel Blog Baru';
        (document.getElementById('blog-form') as HTMLFormElement).reset();
        
        // Auto set current date to Calendar
        const today = new Date();
        const yyyy = today.getFullYear();
        const mm = String(today.getMonth() + 1).padStart(2, '0');
        const dd = String(today.getDate()).padStart(2, '0');
        const todayIso = `${yyyy}-${mm}-${dd}`;
        
        if (blogDatePicker) blogDatePicker.value = todayIso;
        const formatted = formatIndonesianDate(todayIso);
        if (blogDateHidden) blogDateHidden.value = formatted;
        if (blogDatePreview) blogDatePreview.textContent = `Format rilis: ${formatted}`;
        
        (document.getElementById('blog-read-time') as HTMLInputElement).value = '5 min baca';
        
        if (blogDropzoneManager) {
          blogDropzoneManager.setImage('');
        }
        const modal = document.getElementById('blog-modal');
        if (modal) modal.style.display = 'flex';
      });
    }

    // Save Project Form
    const projectForm = document.getElementById('project-form');
    if (projectForm) {
      projectForm.addEventListener('submit', () => {
        const editIdx = parseInt((document.getElementById('project-edit-index') as HTMLInputElement).value, 10);
        const title = (document.getElementById('proj-title') as HTMLInputElement).value.trim();
        const slug = (document.getElementById('proj-slug') as HTMLInputElement).value.trim();
        const category = (document.getElementById('proj-category') as HTMLSelectElement).value;
        const serviceId = (document.getElementById('proj-service-id') as HTMLInputElement).value.trim();
        const image = (document.getElementById('proj-image') as HTMLInputElement).value.trim();
        const description = (document.getElementById('proj-description') as HTMLTextAreaElement).value.trim();
        const featuresRaw = (document.getElementById('proj-features') as HTMLTextAreaElement).value.trim();
        const techsRaw = (document.getElementById('proj-technologies') as HTMLInputElement).value.trim();

        if (!image) {
          alert('Harap unggah screenshot atau gambar thumbnail proyek.');
          return;
        }

        const features = featuresRaw ? featuresRaw.split('\n').map(f => f.trim()).filter(Boolean) : [];
        const technologies = techsRaw ? techsRaw.split(',').map(t => t.trim()).filter(Boolean) : [];

        const projectData = {
          title,
          slug,
          category,
          serviceId: serviceId || 'software',
          image: image,
          description,
          features,
          technologies,
          benefits: []
        };

        if (editIdx >= 0 && editIdx < currentProjects.length) {
          currentProjects[editIdx] = { ...currentProjects[editIdx], ...projectData };
        } else {
          currentProjects.unshift(projectData);
        }

        saveProjectsStore();
        (window as any).closeProjectModal();
      });
    }

    // Save Blog Form
    const blogForm = document.getElementById('blog-form');
    if (blogForm) {
      blogForm.addEventListener('submit', () => {
        const editIdx = parseInt((document.getElementById('blog-edit-index') as HTMLInputElement).value, 10);
        const title = (document.getElementById('blog-title') as HTMLInputElement).value.trim();
        const slug = (document.getElementById('blog-slug') as HTMLInputElement).value.trim();
        const category = (document.getElementById('blog-category') as HTMLSelectElement).value;
        const date = (document.getElementById('blog-date') as HTMLInputElement).value.trim();
        const readTime = (document.getElementById('blog-read-time') as HTMLInputElement).value.trim();
        const image = (document.getElementById('blog-image') as HTMLInputElement).value.trim();
        const excerpt = (document.getElementById('blog-excerpt') as HTMLTextAreaElement).value.trim();
        const tagsRaw = (document.getElementById('blog-tags') as HTMLInputElement).value.trim();

        if (!image) {
          alert('Harap unggah cover gambar untuk artikel blog ini.');
          return;
        }

        const tags = tagsRaw ? tagsRaw.split(',').map(t => t.trim()).filter(Boolean) : [];

        const blogData = {
          title,
          slug,
          category: category || 'Cloud & Infrastructure',
          date: date || 'Hari Ini',
          readTime: readTime || '5 min baca',
          image: image,
          excerpt,
          tags
        };

        if (editIdx >= 0 && editIdx < currentBlogs.length) {
          currentBlogs[editIdx] = { ...currentBlogs[editIdx], ...blogData };
        } else {
          currentBlogs.unshift(blogData);
        }

        saveBlogsStore();
        (window as any).closeBlogModal();
      });
    }

    // Export Helpers
    function downloadFile(filename: string, text: string) {
      const element = document.createElement('a');
      element.setAttribute('href', 'data:text/javascript;charset=utf-8,' + encodeURIComponent(text));
      element.setAttribute('download', filename);
      element.style.display = 'none';
      document.body.appendChild(element);
      element.click();
      document.body.removeChild(element);
    }

    const btnExportProjects = document.getElementById('btn-export-projects');
    if (btnExportProjects) {
      btnExportProjects.addEventListener('click', () => {
        const code = '// Generated by Bolean CMS\nexport const allProjects = ' + 
          JSON.stringify(currentProjects, null, 2) + ';\n';
        downloadFile('projects.js', code);
      });
    }

    const btnExportBlogs = document.getElementById('btn-export-blogs');
    if (btnExportBlogs) {
      btnExportBlogs.addEventListener('click', () => {
        const cats = Array.from(new Set(currentBlogs.map(b => b.category))).filter(Boolean);
        const tags = Array.from(new Set(currentBlogs.flatMap(b => b.tags || []))).filter(Boolean);

        const code = '// Generated by Bolean CMS\nexport const allBlogs = ' + 
          JSON.stringify(currentBlogs, null, 2) + ';\n\nexport const blogCategories = ' + 
          JSON.stringify(cats, null, 2) + ';\n\nexport const blogTags = ' + 
          JSON.stringify(tags, null, 2) + ';\n';
        downloadFile('blogs.js', code);
      });
    }

    // Reset Data
    const btnReset = document.getElementById('btn-reset-data');
    if (btnReset) {
      btnReset.addEventListener('click', () => {
        if (confirm('PERINGATAN: Apakah Anda yakin ingin menghapus seluruh perubahan lokal dan mengembalikan portofolio serta blog ke data bawaan sistem?')) {
          localStorage.removeItem(STORAGE_KEY_PROJECTS);
          localStorage.removeItem(STORAGE_KEY_BLOGS);
          initDataStore();
          alert('Data berhasil direset ke pengaturan awal.');
        }
      });
    }
  });
</script>

