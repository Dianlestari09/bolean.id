<!-- CLIENT SCRIPT LOGIC -->
<script>
  // ==========================================
  // CLIENT-SIDE CMS LOGIC & DATA SYNCHRONIZATION
  // ==========================================
  
  const STORAGE_KEY_AUTH = 'bolean_cms_auth_session';
  const STORAGE_KEY_PROJECTS = 'bolean_cms_projects';
  const STORAGE_KEY_BLOGS = 'bolean_cms_blogs';

  // Retrieve seed data from hidden DOM element
  const seedEl = document.getElementById('cms-seed-data');
  const defaultProjects = seedEl ? JSON.parse(seedEl.getAttribute('data-projects') || '[]') : [];
  const defaultBlogs = seedEl ? JSON.parse(seedEl.getAttribute('data-blogs') || '[]') : [];

  // In-memory data store
  let currentProjects: any[] = [];
  let currentBlogs: any[] = [];

  // Dropzone managers
  let projDropzoneManager: any = null;
  let blogDropzoneManager: any = null;

  // Helper Category Pill Class
  function getCategoryClass(cat: string) {
    const c = (cat || '').toLowerCase();
    if (c.includes('web') || c.includes('software')) return 'pill-blue';
    if (c.includes('mobile')) return 'pill-cyan';
    if (c.includes('iot')) return 'pill-emerald';
    if (c.includes('hardware') || c.includes('server')) return 'pill-purple';
    if (c.includes('cloud') || c.includes('devops')) return 'pill-teal';
    if (c.includes('security') || c.includes('cyber')) return 'pill-amber';
    return 'pill-slate';
  }

  // Indonesian Date Formatter & Parser
  const ID_MONTHS = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];

  function formatIndonesianDate(isoStr: string): string {
    if (!isoStr) return '';
    const parts = isoStr.split('-');
    if (parts.length !== 3) return isoStr;
    const day = parseInt(parts[2], 10);
    const monthIdx = parseInt(parts[1], 10) - 1;
    const year = parts[0];
    return `${day} ${ID_MONTHS[monthIdx] || ''} ${year}`;
  }

  function parseToIsoDate(str: string): string {
    if (!str) return '';
    if (/^\d{4}-\d{2}-\d{2}$/.test(str)) return str;
    const monthsMap: Record<string, string> = {
      'januari': '01', 'februari': '02', 'maret': '03', 'april': '04', 'mei': '05', 'juni': '06',
      'juli': '07', 'agustus': '08', 'september': '09', 'oktober': '10', 'november': '11', 'desember': '12'
    };
    const parts = str.trim().split(/\s+/);
    if (parts.length >= 3) {
      const day = parts[0].padStart(2, '0');
      const month = monthsMap[parts[1].toLowerCase()] || '01';
      const year = parts[2];
      return `${year}-${month}-${day}`;
    }
    return '';
  }

  // Dropzone Setup Function
  function setupDropzone(config: {
    dropzoneId: string;
    fileInputId: string;
    emptyStateId: string;
    filledStateId: string;
    previewImgId: string;
    hiddenInputId: string;
    fileNameId: string;
    changeBtnId: string;
    removeBtnId: string;
    urlToggleBtnId: string;
    urlBoxId: string;
    urlInputId: string;
    applyUrlBtnId: string;
  }) {
    const dropzone = document.getElementById(config.dropzoneId);
    const fileInput = document.getElementById(config.fileInputId) as HTMLInputElement | null;
    const emptyState = document.getElementById(config.emptyStateId);
    const filledState = document.getElementById(config.filledStateId);
    const previewImg = document.getElementById(config.previewImgId) as HTMLImageElement | null;
    const hiddenInput = document.getElementById(config.hiddenInputId) as HTMLInputElement | null;
    const fileName = document.getElementById(config.fileNameId);
    const changeBtn = document.getElementById(config.changeBtnId);
    const removeBtn = document.getElementById(config.removeBtnId);
    const urlToggleBtn = document.getElementById(config.urlToggleBtnId);
    const urlBox = document.getElementById(config.urlBoxId);
    const urlInput = document.getElementById(config.urlInputId) as HTMLInputElement | null;
    const applyUrlBtn = document.getElementById(config.applyUrlBtnId);

    function setImage(src: string, name?: string) {
      if (!hiddenInput) return;
      if (!src) {
        hiddenInput.value = '';
        if (previewImg) previewImg.src = '';
        if (emptyState) emptyState.style.display = 'flex';
        if (filledState) filledState.style.display = 'none';
        return;
      }
      hiddenInput.value = src;
      if (previewImg) previewImg.src = src;
      if (fileName) {
        fileName.textContent = name || (src.startsWith('data:') ? 'gambar-lokal-terupload.png' : (src.split('/').pop() || 'gambar.png'));
      }
      if (emptyState) emptyState.style.display = 'none';
      if (filledState) filledState.style.display = 'flex';
    }

    function handleFile(file: File) {
      if (!file || !file.type.startsWith('image/')) {
        alert('Harap pilih file gambar (PNG, JPG, WEBP, atau GIF).');
        return;
      }
      if (file.size > 8 * 1024 * 1024) {
        alert('Ukuran file terlalu besar. Maksimal 8MB.');
        return;
      }
      const reader = new FileReader();
      reader.onload = (e) => {
        if (e.target && typeof e.target.result === 'string') {
          setImage(e.target.result, file.name);
        }
      };
      reader.readAsDataURL(file);
    }

    if (dropzone && fileInput) {
      dropzone.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('button')) return;
        fileInput.click();
      });

      dropzone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropzone.classList.add('drag-over');
      });

      dropzone.addEventListener('dragleave', () => {
        dropzone.classList.remove('drag-over');
      });

      dropzone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropzone.classList.remove('drag-over');
        if (e.dataTransfer && e.dataTransfer.files.length > 0) {
          handleFile(e.dataTransfer.files[0]);
        }
      });

      fileInput.addEventListener('change', () => {
        if (fileInput.files && fileInput.files.length > 0) {
          handleFile(fileInput.files[0]);
        }
      });
    }

    if (changeBtn && fileInput) {
      changeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        fileInput.click();
      });
    }

    if (removeBtn) {
      removeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        setImage('');
        if (fileInput) fileInput.value = '';
      });
    }

    if (urlToggleBtn && urlBox) {
      urlToggleBtn.addEventListener('click', () => {
        const isShown = urlBox.style.display !== 'none';
        urlBox.style.display = isShown ? 'none' : 'flex';
      });
    }

    if (applyUrlBtn && urlInput) {
      applyUrlBtn.addEventListener('click', () => {
        const url = urlInput.value.trim();
        if (url) {
          setImage(url, url.split('/').pop() || 'gambar-online.png');
          if (urlBox) urlBox.style.display = 'none';
        }
      });
    }

    return { setImage };
  }

  // Init Data Store
  function initDataStore() {
    const storedProjects = localStorage.getItem(STORAGE_KEY_PROJECTS);
    if (storedProjects) {
      try {
        currentProjects = JSON.parse(storedProjects);
      } catch (e) {
        currentProjects = [...defaultProjects];
      }
    } else {
      currentProjects = [...defaultProjects];
      localStorage.setItem(STORAGE_KEY_PROJECTS, JSON.stringify(currentProjects));
    }

    const storedBlogs = localStorage.getItem(STORAGE_KEY_BLOGS);
    if (storedBlogs) {
      try {
        currentBlogs = JSON.parse(storedBlogs);
      } catch (e) {
        currentBlogs = [...defaultBlogs];
      }
    } else {
      currentBlogs = [...defaultBlogs];
      localStorage.setItem(STORAGE_KEY_BLOGS, JSON.stringify(currentBlogs));
    }

    updateDashboardMetrics();
    renderProjectsTable();
    renderBlogsTable();
    populateBlogCategoryFilter();
  }

  function saveProjectsStore() {
    localStorage.setItem(STORAGE_KEY_PROJECTS, JSON.stringify(currentProjects));
    updateDashboardMetrics();
    renderProjectsTable();
  }

  function saveBlogsStore() {
    localStorage.setItem(STORAGE_KEY_BLOGS, JSON.stringify(currentBlogs));
    updateDashboardMetrics();
    renderBlogsTable();
    populateBlogCategoryFilter();
  }

  // Auth Handling
  function checkAuth() {
    const isAuthed = sessionStorage.getItem(STORAGE_KEY_AUTH) || localStorage.getItem(STORAGE_KEY_AUTH);
    const loginSec = document.getElementById('login-section');
    const dashSec = document.getElementById('dashboard-section');

    if (isAuthed === 'true') {
      if (loginSec) loginSec.style.display = 'none';
      if (dashSec) dashSec.style.display = 'block';
      initDataStore();
    } else {
      if (loginSec) loginSec.style.display = 'flex';
      if (dashSec) dashSec.style.display = 'none';
    }
  }

  // Update Metrics
  function updateDashboardMetrics() {
    const statProjects = document.getElementById('stat-total-projects');
    const statBlogs = document.getElementById('stat-total-blogs');
    const badgeProjects = document.getElementById('count-projects-badge');
    const badgeBlogs = document.getElementById('count-blogs-badge');

    if (statProjects) statProjects.textContent = currentProjects.length.toString();
    if (statBlogs) statBlogs.textContent = currentBlogs.length.toString();
    if (badgeProjects) badgeProjects.textContent = currentProjects.length.toString();
    if (badgeBlogs) badgeBlogs.textContent = currentBlogs.length.toString();
  }

  // Render Projects Table
  function renderProjectsTable() {
    const tbody = document.getElementById('projects-table-body');
    const emptyState = document.getElementById('projects-empty-state');
    const searchInput = document.getElementById('search-project-input') as HTMLInputElement | null;
    const filterSelect = document.getElementById('filter-project-category') as HTMLSelectElement | null;

    if (!tbody) return;

    const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
    const catFilter = filterSelect ? filterSelect.value : 'all';

    const filtered = currentProjects.filter(p => {
      const matchQuery = !query || 
        p.title.toLowerCase().includes(query) || 
        p.category.toLowerCase().includes(query) ||
        (p.technologies && p.technologies.some((t: string) => t.toLowerCase().includes(query)));
      
      const matchCat = catFilter === 'all' || p.category.toLowerCase().includes(catFilter.toLowerCase());
      return matchQuery && matchCat;
    });

    if (filtered.length === 0) {
      tbody.innerHTML = '';
      if (emptyState) emptyState.style.display = 'block';
      return;
    }

    if (emptyState) emptyState.style.display = 'none';

    tbody.innerHTML = filtered.map((p) => {
      const realIndex = currentProjects.findIndex(item => item.slug === p.slug);
      const techs = Array.isArray(p.technologies) ? p.technologies : (p.technologies ? p.technologies.split(',') : []);
      const techChips = techs.length > 0 
        ? techs.slice(0, 3).map((t: string) => `<span class="table-chip">${t.trim()}</span>`).join('')
        : '<span class="text-muted">-</span>';

      return `
        <tr>
          <td class="td-cover">
            <div class="thumb-container">
              <img src="${p.image || 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=200'}" alt="${p.title}" class="table-thumb" onerror="this.src='https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=200'" />
            </div>
          </td>
          <td class="td-title">
            <div class="table-title-wrap">
              <a href="/projects/${p.slug}" target="_blank" class="table-title-link" title="Lihat detail proyek">${p.title}</a>
              <p class="table-excerpt">${p.description ? p.description.slice(0, 85) + '...' : ''}</p>
            </div>
          </td>
          <td class="td-category">
            <span class="category-pill ${getCategoryClass(p.category)}">${p.category || 'Solusi IT'}</span>
          </td>
          <td class="td-slug">
            <span class="slug-pill">
              <span class="slug-slash">/</span>projects/${p.slug}
            </span>
          </td>
          <td class="td-tags">
            <div class="chips-wrap">${techChips}</div>
          </td>
          <td class="td-actions" style="text-align: right;">
            <div class="action-btn-group">
              <button class="btn-action btn-edit" onclick="openEditProject(${realIndex})" title="Edit proyek ini">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                <span>Edit</span>
              </button>
              <button class="btn-action btn-delete" onclick="deleteProject(${realIndex})" title="Hapus proyek ini">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" x2="17"/><line x1="14" x2="14" y1="11" x2="17"/></svg>
                <span>Hapus</span>
              </button>
            </div>
          </td>
        </tr>
      `;
    }).join('');
  }

