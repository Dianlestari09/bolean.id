---
import Layout from '../../layouts/Layout.astro';
import { allProjects } from '../../data/projects.js';
import { allBlogs } from '../../data/blogs.js';

// Serialize seed data for client script
const projectsJson = JSON.stringify(allProjects);
const blogsJson = JSON.stringify(allBlogs);
---

<Layout 
  title="Bolean CMS - Control Panel & Content Management"
  description="Panel admin manajemen konten Bolean.id untuk mengelola portofolio proyek dan artikel blog."
>
  <!-- Pass seed data safely to client -->
  <div id="cms-seed-data" data-projects={projectsJson} data-blogs={blogsJson} style="display: none;"></div>

  <!-- AUTH WRAPPER -->
  <div id="admin-app" class="admin-wrapper">
    
    <!-- 1. LOGIN SCREEN (Visible when not authenticated) -->
    <div id="login-section" class="login-container">
      <div class="login-backdrop">
        <div class="login-glow-1"></div>
        <div class="login-glow-2"></div>
      </div>

      <div class="login-card">
        <div class="login-brand">
          <div class="brand-badge-wrap">
            <img src="/logo.png" alt="Bolean Logo" width="140" height="36" class="login-logo-img" />
            <span class="cms-pill">CMS PANEL</span>
          </div>
        </div>
        
        <div class="login-header">
          <h1 class="login-title">Portal Manajemen Konten</h1>
          <p class="login-desc">Masuk untuk mengelola portofolio proyek dan artikel blog Bolean.id.</p>
        </div>

        <div id="login-alert" class="login-alert" style="display: none;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="alert-svg">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          <span id="login-alert-text">Email atau password salah!</span>
        </div>

        <form id="login-form" class="login-form" onsubmit="return false;">
          <div class="form-group">
            <label for="admin-email">Email Administrator</label>
            <div class="input-wrap">
              <span class="input-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="16" x="2" y="4" rx="2"/>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                </svg>
              </span>
              <input 
                type="email" 
                id="admin-email" 
                name="email" 
                value="admin@bolean.id" 
                placeholder="nama@bolean.id" 
                required 
                class="form-control"
              />
            </div>
          </div>

          <div class="form-group">
            <label for="admin-password">Kata Sandi</label>
            <div class="input-wrap">
              <span class="input-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
              </span>
              <input 
                type="password" 
                id="admin-password" 
                name="password" 
                value="admin123" 
                placeholder="••••••••" 
                required 
                class="form-control"
              />
              <button type="button" id="btn-toggle-pwd" class="btn-toggle-pwd" title="Lihat/Sembunyikan sandi">
                <svg id="eye-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
                  <circle cx="12" cy="12" r="3"/>
                </svg>
              </button>
            </div>
          </div>

          <div class="form-options">
            <label class="remember-wrap">
              <input type="checkbox" id="remember-me" checked />
              <span>Ingat sesi di browser ini</span>
            </label>
          </div>

          <button type="submit" id="btn-login" class="btn-login-submit">
            <span>Masuk ke Dashboard</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </button>
        </form>

        <div class="login-footer-hint">
          <span>Kredensial Default:</span>
          <code>admin@bolean.id / admin123</code>
        </div>
      </div>
    </div>


    <!-- 2. DASHBOARD CMS (Visible when authenticated) -->
    <div id="dashboard-section" class="dashboard-container" style="display: none;">
      
      <!-- TOP NAVIGATION BAR -->
      <header class="cms-topbar">
        <div class="topbar-left">
          <div class="cms-logo-link">
            <img src="/logo.png" alt="Bolean Logo" width="120" height="30" class="topbar-logo" />
            <span class="topbar-badge">CMS v2.0</span>
          </div>
          <div class="topbar-separator"></div>
          <div class="topbar-breadcrumb">
            <span class="crumb-root">Portal</span>
            <span class="crumb-slash">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            </span>
            <span class="crumb-active" id="current-tab-label">Ringkasan</span>
          </div>
        </div>

        <div class="topbar-right">
          <a href="/" target="_blank" class="btn-topbar-link" title="Buka website publik">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" x2="21" y1="14" y2="3"/>
            </svg>
            <span>Lihat Website</span>
          </a>

          <div class="admin-status-pill">
            <span class="status-pulse-dot"></span>
            <span class="status-text">Admin Online</span>
          </div>

          <button id="btn-logout" class="btn-topbar-logout" title="Keluar dari sesi admin">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
              <polyline points="16 17 21 12 16 7"/>
              <line x1="21" x2="9" y1="12" y2="12"/>
            </svg>
            <span>Keluar</span>
          </button>
        </div>
      </header>


      <!-- MAIN CMS LAYOUT -->
      <div class="cms-layout-body">
        
        <!-- SIDEBAR -->
        <aside class="cms-sidebar">
          <div class="sidebar-section-title">NAVIGASI UTAMA</div>
          <nav class="cms-nav">
            <button class="cms-nav-item active" data-tab="overview">
              <span class="nav-icon-wrap">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="7" height="9" x="3" y="3" rx="1"/>
                  <rect width="7" height="5" x="14" y="3" rx="1"/>
                  <rect width="7" height="9" x="14" y="12" rx="1"/>
                  <rect width="7" height="5" x="3" y="16" rx="1"/>
                </svg>
              </span>
              <span class="nav-text">Ringkasan</span>
            </button>

            <button class="cms-nav-item" data-tab="projects">
              <span class="nav-icon-wrap">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 8 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/>
                </svg>
              </span>
              <span class="nav-text">Portofolio Project</span>
              <span class="nav-count" id="count-projects-badge">0</span>
            </button>

            <button class="cms-nav-item" data-tab="blogs">
              <span class="nav-icon-wrap">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/>
                  <path d="M6 6h10"/>
                  <path d="M6 10h10"/>
                </svg>
              </span>
              <span class="nav-text">Artikel Blog</span>
              <span class="nav-count" id="count-blogs-badge">0</span>
            </button>
          </nav>

          <div class="sidebar-section-title" style="margin-top: 2rem;">PENGATURAN DATA</div>
          <nav class="cms-nav">
            <button class="cms-nav-item" data-tab="backup">
              <span class="nav-icon-wrap">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <ellipse cx="12" cy="5" rx="9" ry="3"/>
                  <path d="M3 5V19A9 3 0 0 0 21 19V5"/>
                  <path d="M3 12A9 3 0 0 0 21 12"/>
                </svg>
              </span>
              <span class="nav-text">Backup & Ekspor</span>
            </button>
          </nav>

          <!-- SIDEBAR USER FOOTER -->
          <div class="cms-sidebar-footer">
            <div class="user-avatar-initials">AB</div>
            <div class="user-info-stack">
              <strong class="user-name">Admin Bolean</strong>
              <span class="user-role">Super Administrator</span>
            </div>
          </div>
        </aside>


        <!-- CONTENT AREA -->
        <main class="cms-content-area">
          
          <!-- TAB 1: OVERVIEW -->
          <section id="tab-overview" class="cms-tab-content">
            <div class="content-header-banner">
              <div>
                <h2 class="content-heading">Ringkasan Sistem CMS</h2>
                <p class="content-subheading">Pantau metrik portofolio proyek dan artikel blog Bolean.id yang aktif saat ini.</p>
              </div>
            </div>

            <!-- METRICS CARDS -->
            <div class="cms-metrics-row">
              <div class="metric-card">
                <div class="metric-icon-square teal-icon">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 8 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/>
                  </svg>
                </div>
                <div class="metric-data">
                  <span class="metric-label">Total Portofolio Proyek</span>
                  <strong class="metric-value" id="stat-total-projects">0</strong>
                  <span class="metric-note">Tampil di /portofolio</span>
                </div>
              </div>

              <div class="metric-card">
                <div class="metric-icon-square blue-icon">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/>
                    <path d="M6 6h10"/>
                    <path d="M6 10h10"/>
                  </svg>
                </div>
                <div class="metric-data">
                  <span class="metric-label">Total Artikel Blog</span>
                  <strong class="metric-value" id="stat-total-blogs">0</strong>
                  <span class="metric-note">Tampil di /blog</span>
                </div>
              </div>

              <div class="metric-card">
                <div class="metric-icon-square purple-icon">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.9a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/>
                    <path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/>
                    <path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>
                  </svg>
                </div>
                <div class="metric-data">
                  <span class="metric-label">Kategori Layanan</span>
                  <strong class="metric-value">6 Solusi</strong>
                  <span class="metric-note">Software, IoT, Hardware, dll</span>
                </div>
              </div>

              <div class="metric-card">
                <div class="metric-icon-square green-icon">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                    <polyline points="22 4 12 14.01 9 11.01"/>
                  </svg>
                </div>
                <div class="metric-data">
                  <span class="metric-label">Sinkronisasi Database</span>
                  <strong class="metric-value" style="color: #059669; font-size: 1.25rem;">Browser Sync</strong>
                  <span class="metric-note">Otomatis terhubung live</span>
                </div>
              </div>
            </div>

            <!-- QUICK ACTIONS -->
            <div class="overview-section-box">
              <h3 class="box-title">Aksi Cepat</h3>
              <div class="quick-actions-row">
                <button class="quick-btn" onclick="document.querySelector('[data-tab=projects]').click(); setTimeout(() => document.getElementById('btn-add-project').click(), 100);">
                  <div class="quick-btn-icon teal-bg">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="12" y1="5" x2="12" y2="19"/>
                      <line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                  </div>
                  <div class="quick-btn-info">
                    <strong>+ Tambah Portofolio Baru</strong>
                    <p>Input proyek baru beserta screenshot, deskripsi & teknologi</p>
                  </div>
                </button>

                <button class="quick-btn" onclick="document.querySelector('[data-tab=blogs]').click(); setTimeout(() => document.getElementById('btn-add-blog').click(), 100);">
                  <div class="quick-btn-icon blue-bg">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 20h9"/>
                      <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>
                    </svg>
                  </div>
                  <div class="quick-btn-info">
                    <strong>+ Tulis Artikel Blog Baru</strong>
                    <p>Terbitkan tulisan seputar IT, arsitektur, atau studi kasus</p>
                  </div>
                </button>

                <button class="quick-btn" onclick="document.querySelector('[data-tab=backup]').click();">
                  <div class="quick-btn-icon purple-bg">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                      <polyline points="7 10 12 15 17 10"/>
                      <line x1="12" y1="15" x2="12" y2="3"/>
                    </svg>
                  </div>
                  <div class="quick-btn-info">
                    <strong>Unduh Backup / Ekspor</strong>
                    <p>Download file projects.js & blogs.js untuk kode sumber</p>
                  </div>
                </button>
              </div>
            </div>

            <!-- PREVIEW RECENT -->
            <div class="overview-section-box">
              <div class="box-header-flex">
                <h3 class="box-title">Entri Terbaru Portofolio</h3>
                <a href="/portofolio" target="_blank" class="box-link">Buka Halaman Portofolio ↗</a>
              </div>
              <p class="box-desc">Semua perubahan yang disimpan di admin panel ini langsung tersinkronisasi otomatis saat Anda membuka halaman portofolio website.</p>
            </div>
          </section>


          <!-- TAB 2: PORTFOLIO MANAGER -->
          <section id="tab-projects" class="cms-tab-content" style="display: none;">
            <div class="content-header-banner">
              <div>
                <h2 class="content-heading">Manajemen Portofolio Proyek</h2>
                <p class="content-subheading">Kelola studi kasus, kategori layanan, daftar teknologi, dan thumbnail proyek.</p>
              </div>
              <button id="btn-add-project" class="btn-primary-action">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="5" x2="12" y2="19"/>
                  <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                <span>+ Tambah Proyek Baru</span>
              </button>
            </div>

            <!-- FILTER & SEARCH BAR -->
            <div class="cms-control-bar">
              <div class="search-input-wrap">
                <svg class="search-icon-svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"/>
                  <path d="m21 21-4.3-4.3"/>
                </svg>
                <input 
                  type="text" 
                  id="search-project-input" 
                  placeholder="Cari berdasarkan nama proyek, teknologi, atau deskripsi..." 
                  class="control-search"
                />
              </div>

              <div class="filter-select-wrap">
                <select id="filter-project-category" class="control-select">
                  <option value="all">Semua Kategori Proyek</option>
                  <option value="Software">Software & Enterprise</option>
                  <option value="Mobile">Aplikasi Mobile</option>
                  <option value="IoT">Internet of Things</option>
                  <option value="Hardware">Hardware & Server</option>
                </select>
                <svg class="select-chevron-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </div>
            </div>

            <!-- TABLE CONTAINER -->
            <div class="cms-table-card">
              <table class="cms-data-table">
                <thead>
                  <tr>
                    <th style="width: 90px;">Cover</th>
                    <th style="min-width: 260px;">Judul & Deskripsi</th>
                    <th style="width: 150px;">Kategori</th>
                    <th style="width: 180px;">Slug URL</th>
                    <th style="width: 180px;">Teknologi</th>
                    <th style="width: 170px; text-align: right;">Aksi</th>
                  </tr>
                </thead>
                <tbody id="projects-table-body">
                  <!-- Rendered dynamically by client script -->
                </tbody>
              </table>

              <div id="projects-empty-state" class="empty-state" style="display: none;">
                <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"/>
                  <path d="m21 21-4.3-4.3"/>
                </svg>
                <h3>Tidak Ada Proyek Ditemukan</h3>
                <p>Coba gunakan kata kunci pencarian lain atau pilih filter kategori yang berbeda.</p>
              </div>
            </div>
          </section>


          <!-- TAB 3: BLOG MANAGER -->
          <section id="tab-blogs" class="cms-tab-content" style="display: none;">
            <div class="content-header-banner">
              <div>
                <h2 class="content-heading">Manajemen Artikel Blog</h2>
                <p class="content-subheading">Tulis artikel wawasan baru, perbarui tulisan, atau kelola kategori blog.</p>
              </div>
              <button id="btn-add-blog" class="btn-primary-action">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="5" x2="12" y2="19"/>
                  <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                <span>+ Tulis Artikel Baru</span>
              </button>
            </div>

            <!-- FILTER & SEARCH BAR -->
            <div class="cms-control-bar">
              <div class="search-input-wrap">
                <svg class="search-icon-svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"/>
                  <path d="m21 21-4.3-4.3"/>
                </svg>
                <input 
                  type="text" 
                  id="search-blog-input" 
                  placeholder="Cari judul artikel, tag, atau isi ringkasan..." 
                  class="control-search"
                />
              </div>

              <div class="filter-select-wrap">
                <select id="filter-blog-category" class="control-select">
                  <option value="all">Semua Kategori Blog</option>
                  <!-- Populated dynamically -->
                </select>
                <svg class="select-chevron-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </div>
            </div>

            <!-- TABLE CONTAINER -->
            <div class="cms-table-card">
              <table class="cms-data-table">
                <thead>
                  <tr>
                    <th style="width: 90px;">Cover</th>
                    <th style="min-width: 260px;">Judul Artikel</th>
                    <th style="width: 160px;">Kategori</th>
                    <th style="width: 170px;">Tanggal & Waktu</th>
                    <th style="width: 190px;">Tags</th>
                    <th style="width: 170px; text-align: right;">Aksi</th>
                  </tr>
                </thead>
                <tbody id="blogs-table-body">
                  <!-- Rendered dynamically by client script -->
                </tbody>
              </table>

              <div id="blogs-empty-state" class="empty-state" style="display: none;">
                <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"/>
                  <path d="m21 21-4.3-4.3"/>
                </svg>
                <h3>Tidak Ada Artikel Ditemukan</h3>
                <p>Coba gunakan kata kunci pencarian lain atau pilih filter kategori yang berbeda.</p>
              </div>
            </div>
          </section>


          <!-- TAB 4: BACKUP & EXPORT -->
          <section id="tab-backup" class="cms-tab-content" style="display: none;">
            <div class="content-header-banner">
              <div>
                <h2 class="content-heading">Cadangkan & Ekspor Data (Backup)</h2>
                <p class="content-subheading">Unduh file kode sumber JavaScript yang diperbarui untuk disimpan permanen ke server repositori.</p>
              </div>
            </div>

            <div class="backup-grid">
              <div class="backup-card">
                <div class="backup-icon-circle teal-bg">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 8 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/>
                  </svg>
                </div>
