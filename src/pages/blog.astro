---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Blog Kami | Bolean">
  <Navbar />
  <main style="min-height: calc(100vh - 80px); padding-top: 80px;">
    <section class="section section-gray">
      <div class="container">
        <div class="section-header">
          <span class="section-subtitle">Wawasan & Berita</span>
          <h2 class="section-title">Terbaru Dari Blog Kami</h2>
          <p style="color: var(--color-text-muted); margin-top: 1rem;">
            Temukan tren terbaru dalam teknologi, arsitektur cloud, dan transformasi digital.
          </p>
        </div>
        
        <div class="blog-grid">
          <!-- Blog Post 1 -->
          <article class="blog-card">
            <div class="blog-image-wrapper">
              <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Future of Cloud" class="blog-image" />
            </div>
            <div class="blog-content">
              <span class="blog-category">Teknologi</span>
              <h3 class="blog-title"><a href="/blog/future-of-cloud">Masa Depan Arsitektur Cloud di Tahun 2027</a></h3>
              <p class="blog-excerpt">Jelajahi bagaimana komputasi tanpa server dan cloud hibrida membentuk kembali infrastruktur TI perusahaan...</p>
              <div class="blog-meta">
                <span class="blog-date">25 Agustus 2026</span>
                <a href="/blog/future-of-cloud" class="blog-read-more">Baca Selengkapnya →</a>
              </div>
            </div>
          </article>
          
          <!-- Blog Post 2 -->
          <article class="blog-card">
            <div class="blog-image-wrapper">
              <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Why Astro" class="blog-image" />
            </div>
            <div class="blog-content">
              <span class="blog-category">Pengembangan Web</span>
              <h3 class="blog-title"><a href="/blog/why-astro">Mengapa Astro Adalah Pilihan Utama untuk Situs Statis</a></h3>
              <p class="blog-excerpt">Pandangan mendalam tentang arsitektur zero-JS Astro dan bagaimana ini memberikan performa secepat kilat...</p>
              <div class="blog-meta">
                <span class="blog-date">18 Agustus 2026</span>
                <a href="/blog/why-astro" class="blog-read-more">Baca Selengkapnya →</a>
              </div>
            </div>
          </article>
          
          <!-- Blog Post 3 -->
          <article class="blog-card">
            <div class="blog-image-wrapper">
              <img src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Protecting Business Data" class="blog-image" />
            </div>
            <div class="blog-content">
              <span class="blog-category">Keamanan Siber</span>
              <h3 class="blog-title"><a href="/blog/protecting-business-data">Melindungi Data Bisnis Anda di Era Modern</a></h3>
              <p class="blog-excerpt">Praktik keamanan penting yang harus diadopsi oleh setiap bisnis modern agar tetap aman dari ancaman siber...</p>
              <div class="blog-meta">
                <span class="blog-date">12 Agustus 2026</span>
                <a href="/blog/protecting-business-data" class="blog-read-more">Baca Selengkapnya →</a>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2.5rem;
  }
  
  .blog-card {
    background: white;
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    transition: all var(--transition-normal);
    display: flex;
    flex-direction: column;
  }
  
  .blog-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
  }
  
  .blog-image-wrapper {
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
  }
  
  .blog-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }
  
  .blog-card:hover .blog-image {
    transform: scale(1.05);
  }
  
  .blog-content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  
  .blog-category {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 0.75rem;
  }
  
  .blog-title {
    font-size: 1.35rem;
    line-height: 1.4;
    margin-bottom: 1rem;
  }
  
  .blog-title a {
    color: var(--color-secondary);
  }
  
  .blog-title a:hover {
    color: var(--color-primary);
  }
  
  .blog-excerpt {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: 2rem;
    flex-grow: 1;
  }
  
  .blog-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid #e2e8f0;
    padding-top: 1rem;
  }
  
  .blog-date {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  
  .blog-read-more {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-primary);
  }
  
  .blog-read-more:hover {
    color: var(--color-secondary);
  }
</style>
