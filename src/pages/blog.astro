---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Our Blog | Bolean">
  <Navbar />
  <main style="min-height: calc(100vh - 80px); padding-top: 80px;">
    <section class="section section-gray">
      <div class="container">
        <div class="section-header">
          <span class="section-subtitle">Insights & News</span>
          <h2 class="section-title">Latest From Our Blog</h2>
          <p style="color: var(--color-text-muted); margin-top: 1rem;">
            Discover the latest trends in technology, cloud architecture, and digital transformation.
          </p>
        </div>
        
        <div class="blog-grid">
          <!-- Blog Post 1 -->
          <article class="blog-card">
            <div class="blog-image-wrapper">
              <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Future of Cloud" class="blog-image" />
            </div>
            <div class="blog-content">
              <span class="blog-category">Technology</span>
              <h3 class="blog-title"><a href="/blog/future-of-cloud">The Future of Cloud Architecture in 2027</a></h3>
              <p class="blog-excerpt">Explore how serverless computing and hybrid clouds are reshaping enterprise IT infrastructure...</p>
              <div class="blog-meta">
                <span class="blog-date">August 25, 2026</span>
                <a href="/blog/future-of-cloud" class="blog-read-more">Read More →</a>
              </div>
            </div>
          </article>
          
          <!-- Blog Post 2 -->
          <article class="blog-card">
            <div class="blog-image-wrapper">
              <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Why Astro" class="blog-image" />
            </div>
            <div class="blog-content">
              <span class="blog-category">Web Development</span>
              <h3 class="blog-title"><a href="/blog/why-astro">Why Astro is the Ultimate Choice for Static Sites</a></h3>
              <p class="blog-excerpt">An in-depth look at Astro's zero-JS architecture and how it provides lightning-fast performance...</p>
              <div class="blog-meta">
                <span class="blog-date">August 18, 2026</span>
                <a href="/blog/why-astro" class="blog-read-more">Read More →</a>
              </div>
            </div>
          </article>
          
          <!-- Blog Post 3 -->
          <article class="blog-card">
            <div class="blog-image-wrapper">
              <img src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Protecting Business Data" class="blog-image" />
            </div>
            <div class="blog-content">
              <span class="blog-category">Cyber Security</span>
              <h3 class="blog-title"><a href="/blog/protecting-business-data">Protecting Your Business Data in the Modern Era</a></h3>
              <p class="blog-excerpt">Essential security practices every modern business must adopt to stay safe from emerging threats...</p>
              <div class="blog-meta">
                <span class="blog-date">August 12, 2026</span>
                <a href="/blog/protecting-business-data" class="blog-read-more">Read More →</a>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2.5rem;
  }
  
  .blog-card {
    background: white;
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    transition: all var(--transition-normal);
    display: flex;
    flex-direction: column;
  }
  
  .blog-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
  }
  
  .blog-image-wrapper {
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
  }
  
  .blog-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }
  
  .blog-card:hover .blog-image {
    transform: scale(1.05);
  }
  
  .blog-content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  
  .blog-category {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 0.75rem;
  }
  
  .blog-title {
    font-size: 1.35rem;
    line-height: 1.4;
    margin-bottom: 1rem;
  }
  
  .blog-title a {
    color: var(--color-secondary);
  }
  
  .blog-title a:hover {
    color: var(--color-primary);
  }
  
  .blog-excerpt {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: 2rem;
    flex-grow: 1;
  }
  
  .blog-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid #e2e8f0;
    padding-top: 1rem;
  }
  
  .blog-date {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  
  .blog-read-more {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-primary);
  }
  
  .blog-read-more:hover {
    color: var(--color-secondary);
  }
</style>
