---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { allBlogs, blogCategories } from "../../data/blogs.js";

const currentSlug = "why-astro";
const otherBlogs = allBlogs.filter((b) => b.slug !== currentSlug).slice(0, 3);
---

<Layout title="Mengapa Astro Adalah Pilihan Utama untuk Situs Statis | Bolean">
  <Navbar />
  <main style="min-height: calc(100vh - 80px); padding-top: 80px;">
    <section class="section section-light">
      <div class="container blog-detail-layout">
        <!-- Main Content -->
        <article class="blog-main-content">
          <header style="margin-bottom: 2rem;">
            <span
              style="color: var(--color-primary); font-weight: 600; text-transform: uppercase; letter-spacing: 1px;"
              >Pengembangan Web</span
            >
            <h1
              style="font-size: 2.5rem; color: var(--color-secondary); margin: 1rem 0;"
            >
              Mengapa Astro Adalah Pilihan Utama untuk Situs Statis
            </h1>
            <p style="color: var(--color-text-muted);">18 Agustus 2026</p>
          </header>

          <div class="blog-featured-image">
            <img
              src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80"
              alt="Web Development with Astro"
            />
          </div>

          <div class="content" style="font-size: 1.1rem; line-height: 1.8; color: var(--color-text-main);">
            <p>
              Astro JS telah menjadi salah satu framework modern yang paling diminati oleh para developer web saat ini. Keunggulan utamanya terletak pada arsitektur <i>zero-JavaScript</i> yang memastikan kecepatan website luar biasa.
            </p>
            <p>
              Bagi bisnis yang mengutamakan performa dan SEO, memiliki website yang ringan adalah sebuah keharusan mutlak di era digital. Kecepatan muat (loading speed) sangat memengaruhi retensi pengunjung.
            </p>

            <!-- Table of Contents (Daftar Isi) -->
            <div class="article-toc">
              <div class="toc-header" id="toc-toggle">
                <div class="toc-title">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="8" y1="6" x2="21" y2="6"></line>
                    <line x1="8" y1="12" x2="21" y2="12"></line>
                    <line x1="8" y1="18" x2="21" y2="18"></line>
                    <line x1="3" y1="6" x2="3.01" y2="6"></line>
                    <line x1="3" y1="12" x2="3.01" y2="12"></line>
                    <line x1="3" y1="18" x2="3.01" y2="18"></line>
                  </svg>
                  <span>Daftar Isi Artikel</span>
                </div>
                <button class="toc-toggle-btn" aria-label="Toggle Table of Contents">
                  <span id="toc-status-text">Sembunyikan</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>
              </div>
              <ul class="toc-list" id="toc-list">
                <li>
                  <a href="#arsitektur-islands" class="toc-link">
                    <span class="toc-number">1.</span>
                    <span class="toc-text">Arsitektur Islands yang Revolusioner</span>
                  </a>
                </li>
                <li>
                  <a href="#performa-seo" class="toc-link">
                    <span class="toc-number">2.</span>
                    <span class="toc-text">Performa Maksimal untuk SEO Bisnis</span>
                  </a>
                </li>
                <li>
                  <a href="#keunggulan-bolean" class="toc-link">
                    <span class="toc-number">3.</span>
                    <span class="toc-text">Keunggulan Implementasi Website di Bolean</span>
                  </a>
                </li>
              </ul>
            </div>
            
            <div style="background: rgba(13, 168, 158, 0.05); padding: 1rem 1.5rem; border-left: 4px solid var(--color-primary); margin: 1.5rem 0; border-radius: 0 0.5rem 0.5rem 0;">
              <strong>Baca Juga:</strong> <a href="/blog/future-of-cloud" style="color: var(--color-primary); font-weight: 600; text-decoration: none;">Masa Depan Cloud Architecture di 2027</a>
            </div>

            <h2 id="arsitektur-islands" style="margin-top: 2.5rem; color: var(--color-secondary); font-size: 1.8rem;">
              Arsitektur Islands yang Revolusioner
            </h2>
            <p>
              Salah satu fitur andalan dari Astro adalah konsep <i>Islands Architecture</i>. Konsep ini memungkinkan developer untuk mengisolasi komponen interaktif hanya di area tertentu pada halaman website.
            </p>
            <p>
              Artinya, bagian halaman yang statis akan tetap dirender sebagai HTML murni tanpa tambahan beban skrip yang berat. Hal ini membuat performa secara keseluruhan meningkat drastis.
            </p>
            <p>
              Mesin pencari seperti Google sangat menyukai struktur ringan seperti ini, sehingga skor Web Vitals akan meroket dan peringkat SEO website Anda akan jauh lebih optimal.
            </p>

            <h2 id="performa-seo" style="margin-top: 2.5rem; color: var(--color-secondary); font-size: 1.8rem;">
              Performa Maksimal untuk SEO Bisnis
            </h2>
            <p>
              Di Bolean, kami menggunakan Astro secara ekstensif untuk membangun website profil perusahaan yang tidak hanya elegan, tetapi juga secepat kilat. Kami sadar SEO adalah investasi jangka panjang.
            </p>
            <p>
              Dengan kombinasi desain responsif dan kecepatan muat tanpa <i>blocking render</i>, pengunjung tidak akan pernah bosan menunggu halaman website Anda terbuka.
            </p>

            <h2 id="keunggulan-bolean" style="margin-top: 2.5rem; color: var(--color-secondary); font-size: 1.8rem;">
              Keunggulan Implementasi Website di Bolean
            </h2>
            <p>
              Kami mengombinasikan desain UI/UX kelas dunia dengan arsitektur Astro termodern. Hasilnya adalah website yang tidak hanya memikat calon klien, namun juga mendominasi halaman pertama mesin pencari dengan skor Core Web Vitals sempurna 100/100.
            </p>
            <p>
              Jika Anda ingin mendominasi halaman pertama mesin pencari, beralih ke Astro adalah langkah strategis yang sangat kami rekomendasikan untuk masa depan digital Anda.
            </p>


            <div class="article-tags" style="margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--color-surface); display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center;">
              <strong style="color: var(--color-secondary); margin-right: 0.5rem;">Tags:</strong>
              <span style="background: var(--color-surface); padding: 0.3rem 0.8rem; border-radius: 50px; font-size: 0.85rem; color: var(--color-text-muted);">#WebDevelopment</span>
              <span style="background: var(--color-surface); padding: 0.3rem 0.8rem; border-radius: 50px; font-size: 0.85rem; color: var(--color-text-muted);">#AstroJS</span>
              <span style="background: var(--color-surface); padding: 0.3rem 0.8rem; border-radius: 50px; font-size: 0.85rem; color: var(--color-text-muted);">#SEO</span>
              <span style="background: var(--color-surface); padding: 0.3rem 0.8rem; border-radius: 50px; font-size: 0.85rem; color: var(--color-text-muted);">#Performance</span>
            </div>
          </div>
        </article>

        <!-- Sidebar -->
        <aside class="blog-sidebar">
          
          <!-- 1. SEARCH WIDGET -->
          <div class="sidebar-widget">
            <h3 class="widget-title">Search</h3>
            <form action="/blog" method="GET" class="widget-search-form">
              <input 
                type="text" 
                name="q" 
                class="widget-search-input" 
                placeholder="Search here..." 
                aria-label="Search articles"
              />
              <button type="submit" class="widget-search-btn" aria-label="Search">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
              </button>
            </form>
          </div>

          <!-- 2. CATEGORIES WIDGET -->
          <div class="sidebar-widget">
            <h3 class="widget-title">Categories</h3>
            <ul class="widget-category-list">
              {blogCategories.slice(0, 4).map((cat) => (
                <li class="widget-category-item">
                  <a href="/blog" class="widget-category-btn">
                    <span class="cat-name">{cat.name}</span>
                    <span class="cat-count">({String(cat.count).padStart(2, '0')})</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- 3. REKOMENDASI ARTIKEL WIDGET -->
          <div class="sidebar-widget">
            <h3 class="widget-title">Rekomendasi Artikel</h3>
            <div class="widget-recent-posts">
              {otherBlogs.map((post) => (
                <a href={`/blog/${post.slug}`} class="recent-post-item">
                  <div class="recent-post-thumb">
                    <img src={post.image} alt={post.title} loading="lazy" />
                  </div>
                  <div class="recent-post-info">
                    <span class="recent-post-date">{post.date}</span>
                    <h4 class="recent-post-title">{post.title}</h4>
                  </div>
                </a>
              ))}
            </div>
          </div>

        </aside>
      </div>
    </section>
  </main>
  <Footer />
</Layout>


<style>
  .blog-detail-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    max-width: 1200px;
  }

  @media (min-width: 992px) {
    .blog-detail-layout {
      grid-template-columns: 2fr 1fr;
    }
  }

  .blog-featured-image {
    margin-bottom: 3rem;
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .blog-featured-image img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16/9;
    object-fit: cover;
  }

  .sidebar-title {
    font-size: 1.25rem;
    color: var(--color-secondary);
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--color-surface);
  }

  .recommended-articles {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .rec-article-card {
    display: flex;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
    background: white;
    border-radius: var(--border-radius-md);
    padding: 1rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    transition: all var(--transition-fast);
    align-items: center;
  }

  .rec-article-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
  }

  .rec-article-img {
    width: 80px;
    height: 80px;
    border-radius: var(--border-radius-sm);
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
  }

  .rec-article-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .rec-article-info h4 {
    font-size: 1rem;
    color: var(--color-secondary);
    margin: 0;
    line-height: 1.4;
    transition: color var(--transition-fast);
  }

  .rec-article-card:hover .rec-article-info h4 {
    color: var(--color-primary);
  }

  .rec-article-info span {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
</style>
