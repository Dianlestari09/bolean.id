---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { allBlogs, blogCategories } from '../../data/blogs.js';

const currentSlug = 'protecting-business-data';
const otherBlogs = allBlogs.filter((b) => b.slug !== currentSlug).slice(0, 3);
---
<Layout title="Melindungi Data Bisnis Anda di Era Modern | Bolean">
  <Navbar />
  <main style="min-height: calc(100vh - 80px); padding-top: 80px;">
    <section class="section section-light">
      <div class="container blog-detail-layout">
        
        <!-- Main Content -->
        <article class="blog-main-content">
          <header style="margin-bottom: 2rem;">
            <span style="color: var(--color-primary); font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">Keamanan Siber</span>
            <h1 style="font-size: 2.5rem; color: var(--color-secondary); margin: 1rem 0;">Melindungi Data Bisnis Anda di Era Modern</h1>
            <p style="color: var(--color-text-muted);">12 Agustus 2026</p>
          </header>
          
          <div class="blog-featured-image">
            <img src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80" alt="Cyber Security" />
          </div>
          
          <div class="content" style="font-size: 1.1rem; line-height: 1.8; color: var(--color-text-main);">
            <p>
              Keamanan siber bukan lagi sekadar pelengkap, melainkan kebutuhan absolut yang harus diadopsi oleh setiap bisnis modern. Ancaman peretasan kini semakin berevolusi menjadi sangat terstruktur.
            </p>
            <p>
              Seiring dengan percepatan transformasi digital global, tingkat kecanggihan serangan siber juga mengalami lonjakan drastis. Bisnis yang lengah berisiko mengalami kerugian fatal dan hilangnya reputasi.
            </p>

            <!-- Table of Contents (Daftar Isi) -->
            <div class="article-toc">
              <div class="toc-header" id="toc-toggle">
                <div class="toc-title">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="8" y1="6" x2="21" y2="6"></line>
                    <line x1="8" y1="12" x2="21" y2="12"></line>
                    <line x1="8" y1="18" x2="21" y2="18"></line>
                    <line x1="3" y1="6" x2="3.01" y2="6"></line>
                    <line x1="3" y1="12" x2="3.01" y2="12"></line>
                    <line x1="3" y1="18" x2="3.01" y2="18"></line>
                  </svg>
                  <span>Daftar Isi Artikel</span>
                </div>
                <button class="toc-toggle-btn" aria-label="Toggle Table of Contents">
                  <span id="toc-status-text">Sembunyikan</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>
              </div>
              <ul class="toc-list" id="toc-list">
                <li>
                  <a href="#paradigma-zero-trust" class="toc-link">
                    <span class="toc-number">1.</span>
                    <span class="toc-text">Paradigma Zero Trust Architecture</span>
                  </a>
                </li>
                <li>
                  <a href="#enkripsi-multi-layer" class="toc-link">
                    <span class="toc-number">2.</span>
                    <span class="toc-text">Enkripsi Multi-Layer & Manajemen Akses</span>
                  </a>
                </li>
                <li>
                  <a href="#implementasi-keamanan" class="toc-link">
                    <span class="toc-number">3.</span>
                    <span class="toc-text">Implementasi Keamanan Tingkat Lanjut Bersama Bolean</span>
                  </a>
                </li>
              </ul>
            </div>
            
            <div style="background: rgba(13, 168, 158, 0.05); padding: 1rem 1.5rem; border-left: 4px solid var(--color-primary); margin: 1.5rem 0; border-radius: 0 0.5rem 0.5rem 0;">
              <strong>Baca Juga:</strong> <a href="/blog/why-astro" style="color: var(--color-primary); font-weight: 600; text-decoration: none;">Mengapa Astro adalah Pilihan Utama untuk Website Bisnis</a>
            </div>

            <h2 id="paradigma-zero-trust" style="margin-top: 2.5rem; color: var(--color-secondary); font-size: 1.8rem;">
              Paradigma Zero Trust Architecture
            </h2>
            <p>
              Model keamanan tradisional yang hanya berfokus pada pertahanan perimeter terluar kini dianggap telah usang. Pendekatan ini terbukti rentan ketika celah kecil berhasil dieksploitasi oleh peretas.
            </p>
            <p>
              Sebagai gantinya, <i>Zero Trust Architecture</i> (ZTA) hadir dengan prinsip utama "jangan pernah percaya, selalu verifikasi". Sistem ini mewajibkan otentikasi ketat secara berkelanjutan.
            </p>
            <p>
              Setiap permintaan akses, tidak peduli dari mana asalnya atau siapa penggunanya, harus melalui proses otorisasi yang valid. Hal ini membatasi ruang gerak penyusup jika mereka berhasil masuk.
            </p>

            <h2 id="enkripsi-multi-layer" style="margin-top: 2.5rem; color: var(--color-secondary); font-size: 1.8rem;">
              Enkripsi Multi-Layer & Manajemen Akses
            </h2>
            <p>
              Perlindungan data end-to-end dengan standar enkripsi AES-256 dan protokol TLS terbaru memastikan seluruh pertukaran informasi perusahaan terlindungi secara solid baik saat diam (data-at-rest) maupun saat transit (data-in-transit).
            </p>
            <p>
              Penerapan Role-Based Access Control (RBAC) dan Multi-Factor Authentication (MFA) membatasi akses sensitif hanya kepada staf yang berwenang.
            </p>

            <h2 id="implementasi-keamanan" style="margin-top: 2.5rem; color: var(--color-secondary); font-size: 1.8rem;">
              Implementasi Keamanan Tingkat Lanjut Bersama Bolean
            </h2>
            <p>
              Menerapkan arsitektur Zero Trust adalah langkah krusial, tetapi itu hanyalah salah satu pilar perlindungan. Harus dipadukan dengan enkripsi berlapis yang kokoh dan monitoring tanpa henti.
            </p>
            <p>
              Audit keamanan rutin dan pemantauan sistem secara real-time merupakan kewajiban bagi departemen TI Anda. Bolean siap membantu mendesain dan mengamankan seluruh perimeter digital perusahaan Anda.
            </p>


            <div class="article-tags" style="margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--color-surface); display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center;">
              <strong style="color: var(--color-secondary); margin-right: 0.5rem;">Tags:</strong>
              <span style="background: var(--color-surface); padding: 0.3rem 0.8rem; border-radius: 50px; font-size: 0.85rem; color: var(--color-text-muted);">#CyberSecurity</span>
              <span style="background: var(--color-surface); padding: 0.3rem 0.8rem; border-radius: 50px; font-size: 0.85rem; color: var(--color-text-muted);">#ZeroTrust</span>
              <span style="background: var(--color-surface); padding: 0.3rem 0.8rem; border-radius: 50px; font-size: 0.85rem; color: var(--color-text-muted);">#DataProtection</span>
              <span style="background: var(--color-surface); padding: 0.3rem 0.8rem; border-radius: 50px; font-size: 0.85rem; color: var(--color-text-muted);">#BusinessIT</span>
            </div>
          </div>
          
          
        </article>

        <!-- Sidebar -->
        <aside class="blog-sidebar">
          
          <!-- 1. SEARCH WIDGET -->
          <div class="sidebar-widget">
            <h3 class="widget-title">Search</h3>
            <form action="/blog" method="GET" class="widget-search-form">
              <input 
                type="text" 
                name="q" 
                class="widget-search-input" 
                placeholder="Search here..." 
                aria-label="Search articles"
              />
              <button type="submit" class="widget-search-btn" aria-label="Search">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
              </button>
            </form>
          </div>

          <!-- 2. CATEGORIES WIDGET -->
          <div class="sidebar-widget">
            <h3 class="widget-title">Categories</h3>
            <ul class="widget-category-list">
              {blogCategories.slice(0, 4).map((cat) => (
                <li class="widget-category-item">
                  <a href="/blog" class="widget-category-btn">
                    <span class="cat-name">{cat.name}</span>
                    <span class="cat-count">({String(cat.count).padStart(2, '0')})</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- 3. REKOMENDASI ARTIKEL WIDGET -->
          <div class="sidebar-widget">
            <h3 class="widget-title">Rekomendasi Artikel</h3>
            <div class="widget-recent-posts">
              {otherBlogs.map((post) => (
                <a href={`/blog/${post.slug}`} class="recent-post-item">
                  <div class="recent-post-thumb">
                    <img src={post.image} alt={post.title} loading="lazy" />
                  </div>
                  <div class="recent-post-info">
                    <span class="recent-post-date">{post.date}</span>
                    <h4 class="recent-post-title">{post.title}</h4>
                  </div>
                </a>
              ))}
            </div>
          </div>

        </aside>
        
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .blog-detail-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    max-width: 1200px;
  }
  
  @media (min-width: 992px) {
    .blog-detail-layout {
      grid-template-columns: 2fr 1fr;
    }
  }
  
  .blog-featured-image {
    margin-bottom: 3rem;
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
  }
  
  .blog-featured-image img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16/9;
    object-fit: cover;
  }
  
  .sidebar-title {
    font-size: 1.25rem;
    color: var(--color-secondary);
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--color-surface);
  }
  
  .recommended-articles {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .rec-article-card {
    display: flex;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
    background: white;
    border-radius: var(--border-radius-md);
    padding: 1rem;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    transition: all var(--transition-fast);
    align-items: center;
  }
  
  .rec-article-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.1);
  }
  
  .rec-article-img {
    width: 80px;
    height: 80px;
    border-radius: var(--border-radius-sm);
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
  }
  
  .rec-article-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .rec-article-info h4 {
    font-size: 1rem;
    color: var(--color-secondary);
    margin: 0;
    line-height: 1.4;
    transition: color var(--transition-fast);
  }
  
  .rec-article-card:hover .rec-article-info h4 {
    color: var(--color-primary);
  }
  
  .rec-article-info span {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
</style>
