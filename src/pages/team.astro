---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Our Team | Bolean">
  <Navbar />
  <main style="min-height: calc(100vh - 80px); padding-top: 80px;">
    <section class="section section-light">
      <div class="container">
        <div class="section-header">
          <span class="section-subtitle">TALENTA MUDA & BERPENGALAMAN</span>
          <h2 class="section-title">Generasi Muda dengan Jam Terbang Teknologi Tinggi</h2>
          <p style="color: var(--color-text-muted); margin-top: 1rem; max-width: 680px; margin-left: auto; margin-right: auto;">
            Semangat anak muda dengan keahlian teknologi nyata. Tim kami sarat jam terbang dalam rekayasa software, IoT canggih, dan arsitektur sistem modern dengan eksekusi gesit dan presisi.
          </p>
        </div>

        <!-- Team Organization Chart -->
        <div class="team-layout">
          <!-- Leader Row -->
          <div class="leader-row">
            <a href="/team/dian" class="team-card">
              <div class="team-image-wrapper">
                <div class="image-overlay"></div>
                <img
                  src="/images/team/dian.jpg"
                  alt="Dian"
                  class="team-photo"
                />
              </div>
              <div class="team-info">
                <h3 class="team-name">Dian Lestari Kurniawati</h3>
                <p class="team-role">Leader</p>
              </div>
            </a>
          </div>

          <!-- Team Row -->
          <div class="team-row">
            <!-- Team Member 2 -->
            <a href="/team/fahd" class="team-card">
              <div class="team-image-wrapper">
                <div class="image-overlay"></div>
                <img
                  src="/images/team/fahd.jpg"
                  alt="Fahd"
                  class="team-photo"
                />
              </div>
              <div class="team-info">
                <h3 class="team-name">M. Fahd Khulloh</h3>
                <p class="team-role">Software Engineer</p>
              </div>
            </a>

            <!-- Team Member 3 -->
            <a href="/team/iqbal" class="team-card">
              <div class="team-image-wrapper">
                <div class="image-overlay"></div>
                <img
                  src="/images/team/iqbal.jpg"
                  alt="Iqbal"
                  class="team-photo"
                />
              </div>
              <div class="team-info">
                <h3 class="team-name">Maulana Muhammad Iqbal</h3>
                <p class="team-role">Hardware Developer</p>
              </div>
            </a>

            <!-- Team Member 4 -->
            <a href="/team/keysa" class="team-card">
              <div class="team-image-wrapper">
                <div class="image-overlay"></div>
                <img
                  src="/images/team/keysa.jpg"
                  alt="Keysha"
                  class="team-photo"
                />
              </div>
              <div class="team-info">
                <h3 class="team-name">Keysha Qanita Kamila</h3>
                <p class="team-role">Desainer Grafis</p>
              </div>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .team-layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    margin-top: 2rem;
    max-width: 1100px;
    margin-left: auto;
    margin-right: auto;
  }

  .leader-row {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .team-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 3rem;
    width: 100%;
  }

  .team-card {
    /* Guarantee that all cards are exactly the same size */
    width: 100%;
    max-width: 320px;
    position: relative;
    padding-bottom: 3rem; /* Space for the overlapping box */
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .team-image-wrapper {
    width: 100%;
    aspect-ratio: 4 / 5; /* Half body aspect ratio */
    border-radius: 1rem; /* Rounded corners on the image itself */
    overflow: hidden;
    background-color: #082752;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
    transition: box-shadow 0.4s ease;
  }

  .team-card:hover .team-image-wrapper {
    box-shadow: 0 15px 35px rgba(13, 168, 158, 0.25);
  }

  .team-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 10%; /* Focus on upper half */
    transition: transform 0.6s ease, filter 0.4s ease;
  }

  .team-card:hover .team-photo {
    transform: scale(1.08);
    filter: brightness(1.04) contrast(1.02);
  }

  .team-info {
    position: absolute;
    bottom: 0;
    left: 1.25rem;
    right: 1.25rem;
    background: white;
    padding: 1.5rem 1rem;
    text-align: center;
    border-radius: 1rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    z-index: 2;
  }

  .team-card:hover .team-info {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.12);
  }

  .team-name {
    margin-bottom: 0.25rem;
    font-size: 1.25rem;
    color: var(--color-secondary);
    font-weight: 700;
  }

  .team-role {
    color: #64748b; /* Professional slate/gray color for the role */
    font-size: 0.95rem;
    font-weight: 400;
  }
</style>
